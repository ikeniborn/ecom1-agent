      "constraints": [
        {
          "anchor": "<#section > entry in AGENTS.MD>",
          "rule": "<verbatim AGENTS.MD line>",
          "security": true,
          "deny_when": {"op": "<leaf or bool op>", "lhs": "$<ref>", "rhs": "<literal or $ref>"}
