    CREATE INDEX return_requests_customer_idx ON return_requests(customer_id)
    CREATE INDEX return_requests_payment_idx ON return_requests(payment_id)
    CREATE INDEX return_requests_status_idx ON return_requests(return_status)
    CREATE INDEX shopping_basket_items_sku_idx ON shopping_basket_items(product_sku)
    CREATE INDEX shopping_baskets_created_at_idx ON shopping_baskets(basket_created_at)
    "CREATE INDEX shopping_baskets_customer_created_at_idx ON shopping_baskets(customer_id, basket_created_at)"
    CREATE INDEX shopping_baskets_customer_idx ON shopping_baskets(customer_id)
    CREATE INDEX shopping_baskets_store_idx ON shopping_baskets(store_id)
