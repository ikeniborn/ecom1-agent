    "CREATE INDEX product_variant_properties_key_text_idx ON product_variant_properties(property_key, property_value_text)"
    CREATE INDEX product_variants_brand_idx ON product_variants(brand)
    CREATE INDEX product_variants_kind_idx ON product_variants(product_kind_id)
