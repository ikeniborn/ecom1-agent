      "rule_content": "<starts with Never|Always|Use|Do not|When|If|Prefer>",
      "agents_md_anchor": "<#section> or null",
      "reasoning": "<diagnosis: verbatim error, root cause, failing PlanIR fragment, rule linkage>",
      "deactivate_ids": ["rXXX"],
