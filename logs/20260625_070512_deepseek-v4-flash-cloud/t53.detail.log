      ],
      "rowsets": [
        {
          "from": "<env key of raw text>",
          "format": "auto_delim",
          "into": "<env key for parsed rows>",
          "columns": [
            {"into": "<field name>", "candidates": ["<col header variant>", "..."]}
          ]
        }
      ],
      "compute": [
        {"prim": "<primitive name>", "args": ["$ref_or_literal", "..."], "into": "<env key>"}
      ],
      "decision": {
        "branches": [
          {"when": {"op": "<PredExpr op>", "lhs": "$ref", "rhs": "value"}, "label": "<label>"}
        ],
        "default_label": "<label>"
      },
      "ops": [
        {
          "rpc": "<RPC name>",
