    - (SQL, Database, Analytics, Reporting) ```sql
    -- Replace {{product_kind}} with the desired product kind name (e.g., 'Work Jacket')
    SELECT COUNT(*) AS product_count
    FROM product_variants v
    JOIN product_kinds k ON v.product_kind_id = k.product_kind_id
    WHERE k.product_kind_name = '{{product_kind}}';
