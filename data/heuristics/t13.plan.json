{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT store_id, record_path FROM stores WHERE city = 'Bratislava' AND store_name = 'Stare Mesto hardware branch';"
      },
      "bind": "store_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "store_raw",
      "format": "auto_delim",
      "into": "store_rows",
      "columns": [
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "store_record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [],
  "decision": {
    "branches": [],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "unsupported": {
      "message": "Unable to count products: product descriptions not provided.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}