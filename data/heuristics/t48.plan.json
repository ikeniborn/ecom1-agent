{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/archive/payment_batch_export_DXad65HdYb.tsv"
      },
      "bind": "tsv_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "tsv_content",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "fraud_indicator",
          "candidates": [
            "incident_type",
            "fraud_flag"
          ]
        },
        {
          "into": "payment_amount",
          "candidates": [
            "payment_amount_cents",
            "amount"
          ]
        },
        {
          "into": "row_id",
          "candidates": [
            "RowID",
            "row_id"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$tsv_raw",
        "content"
      ],
      "into": "tsv_content"
    },
    {
      "prim": "first",
      "args": [
        "$rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "filter_rows",
      "args": [
        "$rows",
        "fraud_indicator != ''"
      ],
      "into": "fraud_rows"
    },
    {
      "prim": "column",
      "args": [
        "$fraud_rows",
        "row_id"
      ],
      "into": "fraud_row_paths"
    },
    {
      "prim": "sum_col",
      "args": [
        "$fraud_rows",
        "payment_amount"
      ],
      "into": "total_fraud_amount_cents"
    },
    {
      "prim": "div",
      "args": [
        "$total_fraud_amount_cents",
        100
      ],
      "into": "euros"
    },
    {
      "prim": "div",
      "args": [
        "$euros",
        0.01
      ],
      "into": "euros_times_100"
    },
    {
      "prim": "abs_diff",
      "args": [
        "$total_fraud_amount_cents",
        "$euros_times_100"
      ],
      "into": "cents"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "isnull",
              "lhs": "$first_row.fraud_indicator",
              "rhs": null,
              "args": []
            },
            {
              "op": "isnull",
              "lhs": "$first_row.payment_amount",
              "rhs": null,
              "args": []
            },
            {
              "op": "isnull",
              "lhs": "$first_row.row_id",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "OUTCOME_NONE_UNSUPPORTED"
      }
    ],
    "default_label": "proceed"
  },
  "ops": [],
  "answer": {
    "OUTCOME_NONE_UNSUPPORTED": {
      "message": "The TSV file does not contain the required columns for fraud detection.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "proceed": {
      "message": "EUR {euros}.{cents:02d}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$fraud_row_paths"
        }
      ]
    }
  },
  "custom_extract": []
}