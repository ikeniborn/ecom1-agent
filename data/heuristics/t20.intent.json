{
  "objective": "Compute the total number of units of a specific product available today across all PowerTool stores in Vienna, including stores with zero availability.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "product_brand": "literal 'Sika' from instruction",
    "product_family_name": "literal 'Sika Weatherproof Sikaflex 1JG-02A Sealant' from instruction",
    "sealant_type": "literal 'silicone sealant' from instruction",
    "color_family": "literal 'Gray' from instruction",
    "volume": "literal '100 ml' from instruction",
    "city": "literal 'Vienna' from instruction"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$product.record_path",
        "rhs": null,
        "args": []
      },
      {
        "op": "ge",
        "lhs": "$count",
        "rhs": 0,
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "count: {count}",
    "kind": "",
    "columns": [],
    "rows_from": ""
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "record_path",
        "path": null,
        "source": "$product.record_path"
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$store_record_paths"
      }
    ]
  }
}