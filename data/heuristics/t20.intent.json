{
  "objective": "Compute the total available_today_quantity of a specific Record Power compressor/dust extractor product across all Vienna stores, including stores with zero availability, and report the count with citations of every Vienna store record and the product record.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "product_sku": "Lookup from product_variant_properties and product_variants: find SKU where brand = 'Record Power' and the product has property_key 'machine_type' = 'compressor', 'voltage' = '230 V', 'power' = '3000 W'. Join product_variant_properties to product_variants on product_sku.",
    "vienna_stores": "Lookup from stores WHERE city = 'Vienna'",
    "availability": "For each store in vienna_stores, retrieve available_today_quantity from store_inventory WHERE store_id = store.store_id AND product_sku = product_sku. If no record, treat as 0."
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "ge",
        "lhs": "$count",
        "rhs": 0,
        "args": []
      },
      {
        "op": "nonempty",
        "lhs": "$product.record_path",
        "rhs": null,
        "args": []
      },
      {
        "op": "nonempty",
        "lhs": "$vienna_stores",
        "rhs": null,
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "count: {count}",
    "kind": "",
    "columns": [],
    "rows_from": ""
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "record_path",
        "path": null,
        "source": "$product.record_path"
      },
      {
