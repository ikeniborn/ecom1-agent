{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/ops-policy-notes/catalogue-count-wiring-devices-brno-2021-08-09.md"
      },
      "bind": "policy_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(DISTINCT pv.product_sku) AS cnt FROM product_variants pv WHERE pv.product_kind_id = 'wiring_devices' AND EXISTS (SELECT 1 FROM store_inventory si JOIN stores s ON si.store_id = s.store_id WHERE si.product_sku = pv.product_sku AND s.city = 'Brno' AND s.is_open = 1 AND s.store_name LIKE '%PowerTool%' AND si.available_today_quantity > 0);"
      },
      "bind": "sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_output",
      "format": "auto_delim",
      "into": "count_rows",
      "columns": [
        {
          "into": "cnt",
          "candidates": [
            "cnt",
            "count",
            "COUNT(*)"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$count_rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "cnt"
      ],
      "into": "count_str"
    },
    {
      "prim": "to_number",
      "args": [
        "$count_str"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "[QTY:{count}]",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}