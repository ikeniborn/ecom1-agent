{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path, job_title, store_id, employee_email FROM employee_accounts WHERE employee_display_name = 'Greta Engel';"
      },
      "bind": "emp_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path, store_name FROM stores WHERE store_name = 'PowerTool Innsbruck Wilten';"
      },
      "bind": "store_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "emp_raw",
      "format": "auto_delim",
      "into": "emp_rows",
      "columns": [
        {
          "into": "emp_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "job_title",
          "candidates": [
            "job_title"
          ]
        },
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "employee_email",
          "candidates": [
            "employee_email"
          ]
        }
      ]
    },
    {
      "from_": "store_raw",
      "format": "auto_delim",
      "into": "store_rows",
      "columns": [
        {
          "into": "store_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "store_name",
          "candidates": [
            "store_name"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$emp_rows"
      ],
      "into": "emp"
    },
    {
      "prim": "first",
      "args": [
        "$store_rows"
      ],
      "into": "store"
    },
    {
      "prim": "get",
      "args": [
        "$emp",
        "employee_email"
      ],
      "into": "email"
    },
    {
      "prim": "get",
      "args": [
        "$emp",
        "emp_path"
      ],
      "into": "emp_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$store",
        "store_path"
      ],
      "into": "store_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$emp",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$store",
              "rhs": null,
              "args": []
            },
            {
              "op": "contains_any",
              "lhs": "$emp.job_title",
              "rhs": [
                "Manager"
              ],
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$emp.store_id",
              "rhs": "$store.store_id",
              "args": []
            }
          ]
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "Greta Engel's management of PowerTool Innsbruck Wilten: Yes. Email: {email}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$emp_record_path"
        }
      ]
    },
    "unsupported": {
      "message": "Greta Engel is not the manager of PowerTool Innsbruck Wilten.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$store_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}