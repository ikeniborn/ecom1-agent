{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "_identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH store AS (SELECT store_id FROM stores WHERE store_name = 'PowerTool Graz Lend') SELECT s.store_id, s.store_name, e.employee_id, e.employee_display_name, e.employee_email, e.record_path FROM store s, employee_accounts e WHERE e.store_id = s.store_id AND e.employee_display_name = 'Alina Heinrich';"
      },
      "bind": "_result_row"
    }
  ],
  "rowsets": [
    {
      "from_": "_result_row",
      "format": "auto_delim",
      "into": "_parsed_rows",
      "columns": [
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "store_name",
          "candidates": [
            "store_name"
          ]
        },
        {
          "into": "employee_id",
          "candidates": [
            "employee_id"
          ]
        },
        {
          "into": "employee_display_name",
          "candidates": [
            "employee_display_name"
          ]
        },
        {
          "into": "employee_email",
          "candidates": [
            "employee_email"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$_parsed_rows"
      ],
      "into": "_manager"
    },
    {
      "prim": "get",
      "args": [
        "$_manager",
        "employee_display_name"
      ],
      "into": "_manager_name"
    },
    {
      "prim": "get",
      "args": [
        "$_manager",
        "employee_email"
      ],
      "into": "_email"
    },
    {
      "prim": "get",
      "args": [
        "$_manager",
        "record_path"
      ],
      "into": "_manager_employee_record_path"
    },
    {
      "prim": "count",
      "args": [
        "$_parsed_rows"
      ],
      "into": "_row_count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "regex_match",
          "lhs": "$_identity_raw",
          "rhs": "guest",
          "args": []
        },
        "label": "deny_security"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$_row_count",
          "rhs": 0,
          "args": []
        },
        "label": "not_found"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "deny_security": {
      "message": "Access denied: guests cannot view employee personal data.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "not_found": {
      "message": "Could not find the manager Alina Heinrich for PowerTool Graz Lend.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    },
    "ok": {
      "message": "Alina Heinrich is the manager of PowerTool Graz Lend. Their email is {email}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$_manager_employee_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}