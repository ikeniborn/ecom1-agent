{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "policy_doc"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$identity.kind",
              "rhs": "guest",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "employee_email_lookup",
              "rhs": "employee_email_lookup",
              "args": []
            }
          ]
        },
        "label": "deny"
      }
    ],
    "default_label": "deny"
  },
  "ops": [],
  "answer": {
    "deny": {
      "message": "Access denied: guest users cannot access employee contact information.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": "policy_doc"
        }
      ]
    }
  },
  "custom_extract": []
}