{
  "objective": "Determine if the total price (excluding VAT) of the products from an old receipt in /uploads/ would differ by no more than 3 EUR from today's prices.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "old_receipt_path": "the file path in /uploads/ as specified in the instruction",
    "old_receipt_contents": "read the file at $old_receipt_path using a file read RPC if available",
    "old_items": "parse the receipt to extract a list of {product_sku, quantity, unit_price_cents} from $old_receipt_contents",
    "current_prices": "for each product_sku in $old_items, query product_variants.price_cents",
    "old_total_cents": "sum over $old_items of (unit_price_cents * quantity)",
    "new_total_cents": "sum over $old_items of (current_price_cents * quantity)",
    "difference_cents": "abs($new_total_cents - $old_total_cents)",
    "threshold_cents": 300,
    "within_threshold": "$difference_cents <= $threshold_cents"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_DENIED_SECURITY",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [
    {
      "anchor": "#tools/rpcs",
      "rule": "tools/rpcs: --help, docs, sqlite_schema",
      "security": false,
      "deny_when": null
    },
    {
      "anchor": "#catalog",
      "rule": "catalog/paths: /PROD, /docs/powertools-agentic-os-origin-story.md, /catalog, /stores, /employees, /customers, /baskets, /payments, /bin, /bin/sql, /customer/guest, /finalization, /no",
      "security": true,
      "deny_when": {
        "op": "not",
        "lhs": null,
        "rhs": null,
        "args": [
          {
            "op": "in_set",
            "lhs": "$file_path",
            "rhs": [
              "/PROD",
              "/docs/powertools-agentic-os-origin-story.md",
              "/catalog",
              "/stores",
              "/employees",
              "/customers",
              "/baskets",
              "/payments",
              "/bin",
              "/bin/sql",
              "/customer/guest",
              "/finalization",
              "/no"
            ],
            "args": []
          }
        ]
      }
    }
  ],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$answer.within_threshold",
        "rhs": null,
        "args": []
      },
      {
        "op": "nonempty",
        "lhs": "$answer.difference_cents",
        "rhs": null,
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "The total price difference is {difference_cents} cents ({difference_eur} EUR), which is {within_threshold ? 'within' : 'exceeds'} the 3 EUR threshold."
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "record_path",
        "path": null,
        "source": "$product_variants_rows.record_path"
      }
    ],
    "OUTCOME_DENIED_SECURITY": [
      {
        "kind": "policy_doc",
        "path": "/docs/security.md",
        "source": null
      }
    ],
    "OUTCOME_NONE_UNSUPPORTED": []
  }
}