{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH family AS (SELECT product_family_id FROM product_families WHERE brand='DeWalt' AND product_family_name LIKE '%DCG 2BH-302%'), variant AS (SELECT product_sku, record_path FROM product_variants WHERE brand='DeWalt' AND product_family_id IN (SELECT product_family_id FROM family) AND product_name LIKE '%Corded Angle Grinder%'), props AS (SELECT v.product_sku, v.record_path, MAX(CASE WHEN p.property_key='Disc Diameter' AND p.property_value_text='180 mm' THEN 1 ELSE 0 END) as diam_180, MAX(CASE WHEN p.property_key='Disc Diameter' AND p.property_value_text='150 mm' THEN 1 ELSE 0 END) as diam_150 FROM variant v LEFT JOIN product_variant_properties p ON v.product_sku = p.product_sku GROUP BY v.product_sku, v.record_path) SELECT product_sku, record_path, diam_180, diam_150 FROM props;"
      },
      "bind": "raw_sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_output",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "diam_180",
          "candidates": [
            "diam_180"
          ]
        },
        {
          "into": "diam_150",
          "candidates": [
            "diam_150"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "product_variant"
    },
    {
      "prim": "get",
      "args": [
        "$product_variant",
        "product_sku"
      ],
      "into": "sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_variant",
        "diam_180"
      ],
      "into": "diam_180_val"
    },
    {
      "prim": "get",
      "args": [
        "$product_variant",
        "diam_150"
      ],
      "into": "diam_150_val"
    },
    {
      "prim": "to_number",
      "args": [
        "$diam_180_val"
      ],
      "into": "diam_180_num"
    },
    {
      "prim": "to_number",
      "args": [
        "$diam_150_val"
      ],
      "into": "diam_150_num"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$diam_180_num",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$diam_150_num",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "Checked product {sku}: both diameters present.",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$product_variant.record_path"
      ]
    },
    "unsupported": {
      "message": "Checked product {sku}: extra claim absent, answer <NO> with SKU {sku}",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}