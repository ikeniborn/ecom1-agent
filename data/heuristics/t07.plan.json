{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH found AS (SELECT product_sku, record_path FROM product_variants WHERE LOWER(brand) = LOWER('Caparol') AND LOWER(product_name) LIKE LOWER('%' || 'Caparol Premium Capa 32D-5X8 Metal and Concrete Paint' || '%') LIMIT 1) SELECT f.product_sku, f.record_path, p1.property_value_text AS prop_concrete_sealer, p2.property_value_text AS prop_color_gray, p3.property_value_text AS prop_metal_paint FROM found f LEFT JOIN product_variant_properties p1 ON f.product_sku = p1.product_sku AND LOWER(p1.property_key) = LOWER('product_type') AND LOWER(p1.property_value_text) = LOWER('concrete sealer') LEFT JOIN product_variant_properties p2 ON f.product_sku = p2.product_sku AND LOWER(p2.property_key) = LOWER('color_family') AND LOWER(p2.property_value_text) = LOWER('Gray') LEFT JOIN product_variant_properties p3 ON f.product_sku = p3.product_sku AND LOWER(p3.property_key) = LOWER('product_type') AND LOWER(p3.property_value_text) = LOWER('metal paint');"
      },
      "bind": "product_query_result"
    }
  ],
  "rowsets": [
    {
      "from_": "product_query_result",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "prop_concrete_sealer",
          "candidates": [
            "prop_concrete_sealer"
          ]
        },
        {
          "into": "prop_color_gray",
          "candidates": [
            "prop_color_gray"
          ]
        },
        {
          "into": "prop_metal_paint",
          "candidates": [
            "prop_metal_paint"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "product_row"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "product_sku"
      ],
      "into": "sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "record_path"
      ],
      "into": "record_path_val"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "prop_concrete_sealer"
      ],
      "into": "prop_concrete_sealer_val"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "prop_color_gray"
      ],
      "into": "prop_color_gray_val"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "prop_metal_paint"
      ],
      "into": "prop_metal_paint_val"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_row",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$prop_concrete_sealer_val",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$prop_color_gray_val",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$prop_metal_paint_val",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "ok"
      },
      {
        "when": {
          "op": "nonempty",
          "lhs": "$product_row",
          "rhs": null,
          "args": []
        },
        "label": "unsupported_missing_props"
      }
    ],
    "default_label": "unsupported_not_found"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "Claim check result: OK SKU: {sku}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "source": "$record_path_val"
        }
      ]
    },
    "unsupported_missing_props": {
      "message": "Claim check result: Unsupported (missing properties) SKU: {sku}",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "record_path",
          "source": "$record_path_val"
        }
      ]
    },
    "unsupported_not_found": {
      "message": "Claim check result: Unsupported (product not found) SKU: N/A",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}