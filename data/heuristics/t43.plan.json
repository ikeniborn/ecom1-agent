{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT 'unauthenticated guest' AS reason;"
      },
      "bind": "reason_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "identity_raw",
      "format": "json",
      "into": "identity_rows",
      "columns": [
        {
          "into": "kind",
          "candidates": [
            "kind"
          ]
        }
      ]
    },
    {
      "from_": "reason_raw",
      "format": "auto_delim",
      "into": "reason_rows",
      "columns": [
        {
          "into": "reason",
          "candidates": [
            "reason"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "column",
      "args": [
        "$identity_rows",
        "kind"
      ],
      "into": "kind_list"
    },
    {
      "prim": "first",
      "args": [
        "$kind_list"
      ],
      "into": "identity_kind"
    },
    {
      "prim": "column",
      "args": [
        "$reason_rows",
        "reason"
      ],
      "into": "reason_list"
    },
    {
      "prim": "first",
      "args": [
        "$reason_list"
      ],
      "into": "reason"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity_kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied"
      }
    ],
    "default_label": "denied"
  },
  "ops": [],
  "answer": {
    "denied": {
      "message": "Refund request denied: {reason}",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    }
  },
  "custom_extract": []
}