{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_doc"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "denied": {
      "message": "Access denied: guests are not authorized to access payment records.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": "$security_doc"
        }
      ]
    },
    "ok": {
      "message": "Unexpected outcome: this branch should not be reached under current identity.",
      "outcome": "OUTCOME_ERR_INTERNAL",
      "refs": []
    }
  },
  "custom_extract": []
}