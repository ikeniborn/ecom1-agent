{
  "discovery": [
    {
      "rpc": "Search",
      "args": {
        "pattern": "fraud incident",
        "root": "/docs",
        "limit": 10
      },
      "bind": "search_results"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/merchant-continuity-and-critical-incidents.md"
      },
      "bind": "incident_doc"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$search_results",
        "results"
      ],
      "into": "search_results_list"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$search_results_list",
          "rhs": "",
          "args": []
        },
        "label": "found_incident"
      }
    ],
    "default_label": "clarify"
  },
  "ops": [],
  "answer": {
    "clarify": {
      "message": "Clarification needed: Please specify the criteria or identifier for the confirmed fraud incident, e.g., a specific payment_id, basket_id, or a set of conditions such as payment_status or 3DS failure patterns.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    },
    "found_incident": {
      "message": "Found potential incident definition. Please specify which incident you are referring to.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    }
  },
  "custom_extract": []
}