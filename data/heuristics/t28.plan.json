{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/discounts.md"
      },
      "bind": "policy_discounts"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "policy_security"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH store AS (SELECT store_id, record_path FROM stores WHERE store_name = 'PowerTool Vienna Meidling'), employee AS (SELECT employee_id, record_path FROM employee_accounts WHERE employee_display_name = 'Frederike Blom' AND store_id IN (SELECT store_id FROM store)), role AS (SELECT role_code FROM employee_role_assignments WHERE employee_id IN (SELECT employee_id FROM employee)) SELECT store.store_id, store.record_path as store_path, employee.employee_id, employee.record_path as employee_path, role.role_code FROM store, employee, role LIMIT 1;"
      },
      "bind": "manager_sql"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT basket_id, record_path, discount_percent, discount_reason_code, discount_issuer_employee_id, basket_status FROM shopping_baskets WHERE basket_id = 'basket_054';"
      },
      "bind": "basket_sql"
    }
  ],
  "rowsets": [
    {
      "from_": "identity_raw",
      "format": "json",
      "into": "identity",
      "columns": []
    },
    {
      "from_": "manager_sql",
      "format": "auto_delim",
      "into": "manager_rows",
      "columns": [
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "store_path",
          "candidates": [
            "store_path"
          ]
        },
        {
          "into": "employee_id",
          "candidates": [
            "employee_id"
          ]
        },
        {
          "into": "employee_path",
          "candidates": [
            "employee_path"
          ]
        },
        {
          "into": "role_code",
          "candidates": [
            "role_code"
          ]
        }
      ]
    },
    {
      "from_": "basket_sql",
      "format": "auto_delim",
      "into": "basket_rows",
      "columns": [
        {
          "into": "basket_id",
          "candidates": [
            "basket_id"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "discount_percent",
          "candidates": [
            "discount_percent"
          ]
        },
        {
          "into": "discount_reason_code",
          "candidates": [
            "discount_reason_code"
          ]
        },
        {
          "into": "discount_issuer_employee_id",
          "candidates": [
            "discount_issuer_employee_id"
          ]
        },
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$identity"
      ],
      "into": "identity_obj"
    },
    {
      "prim": "first",
      "args": [
        "$manager_rows"
      ],
      "into": "manager"
    },
    {
      "prim": "first",
      "args": [
        "$basket_rows"
      ],
      "into": "basket"
    },
    {
      "prim": "get",
      "args": [
        "$manager",
        "employee_id"
      ],
      "into": "emp_id"
    },
    {
      "prim": "concat",
      "args": [
        "UPDATE shopping_baskets SET discount_percent = 5, discount_reason_code = 'service_recovery', discount_issuer_employee_id = '",
        "$emp_id"
      ],
      "into": "sql_part1"
    },
    {
      "prim": "concat",
      "args": [
        "$sql_part1",
        "' WHERE basket_id = 'basket_054';"
      ],
      "into": "update_sql"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity_obj.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_guest"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$manager.role_code",
          "rhs": "store_manager",
          "args": []
        },
        "label": "denied_role"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$basket.basket_status",
          "rhs": "active",
          "args": []
        },
        "label": "clarify_status"
      },
      {
        "when": {
          "op": "nonempty",
          "lhs": "$basket.discount_percent",
          "rhs": null,
          "args": []
        },
        "label": "clarify_discount"
      }
    ],
    "default_label": "ok"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "$update_sql"
      },
      "bind": null,
      "guard_label": "ok",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "denied_guest": {
      "message": "Cannot apply discount: unauthorized (guest).",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    },
    "denied_role": {
      "message": "Cannot apply discount: manager role not store_manager.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    },
    "clarify_status": {
      "message": "Cannot apply discount: basket not active.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        }
      ]
    },
    "clarify_discount": {
      "message": "Cannot apply discount: basket already has discount.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        }
      ]
    },
    "ok": {
      "message": "Confirmed manager Frederike Blom and applied 5% service_recovery discount to basket basket_054.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$manager.employee_path"
        }
      ]
    }
  },
  "custom_extract": []
}