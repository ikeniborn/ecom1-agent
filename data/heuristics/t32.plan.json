{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": ".mode tabs\nSELECT pv.product_sku, pv.record_path, MAX(CASE WHEN pvp.property_key='color_family' THEN pvp.property_value_text END) as color_family, MAX(CASE WHEN pvp.property_key='size' THEN pvp.property_value_text END) as size, MAX(CASE WHEN pvp.property_key='fit' THEN pvp.property_value_text END) as fit, MAX(CASE WHEN pvp.property_key='bluetooth_control' THEN pvp.property_value_text END) as bluetooth_control FROM product_variants pv LEFT JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku WHERE pv.brand = 'Engelbert Strauss' AND pv.series = 'e.s.motion vision 39A-KCI' AND pv.model = 'Work Trousers' GROUP BY pv.product_sku, pv.record_path;"
      },
      "bind": "raw_product"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_product",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "color_family",
          "candidates": [
            "color_family"
          ]
        },
        {
          "into": "size",
          "candidates": [
            "size"
          ]
        },
        {
          "into": "fit",
          "candidates": [
            "fit"
          ]
        },
        {
          "into": "bluetooth_control",
          "candidates": [
            "bluetooth_control"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "product_row"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "record_path"
      ],
      "into": "record_path"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "color_family"
      ],
      "into": "color_family"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "size"
      ],
      "into": "size"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "fit"
      ],
      "into": "fit"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "bluetooth_control"
      ],
      "into": "bluetooth_control"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$product_sku",
          "rhs": null,
          "args": []
        },
        "label": "not_found"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$color_family",
              "rhs": "Gray",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$size",
              "rhs": "3XL",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$fit",
              "rhs": "women",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$bluetooth_control",
              "rhs": "true",
              "args": []
            }
          ]
        },
        "label": "ok"
      },
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "isnull",
              "lhs": "$bluetooth_control",
              "rhs": null,
              "args": []
            },
            {
              "op": "ne",
              "lhs": "$bluetooth_control",
              "rhs": "true",
              "args": []
            }
          ]
        },
        "label": "unsupported"
      }
    ],
    "default_label": "clarification"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "The product exists: {record_path} with SKU {product_sku}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "source": "$record_path"
        }
      ]
    },
    "unsupported": {
      "message": "<NO> {product_sku}",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "record_path",
          "source": "$record_path"
        }
      ]
    },
    "not_found": {
      "message": "Product not found.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    },
    "clarification": {
      "message": "Product not found.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    }
  },
  "custom_extract": []
}