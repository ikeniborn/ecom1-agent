{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [
          "SELECT product_sku, product_name, record_path FROM product_variants WHERE LOWER(TRIM(brand)) = LOWER(TRIM(:brand)) AND LOWER(TRIM(series)) = LOWER(TRIM(:series)) AND LOWER(TRIM(model)) = LOWER(TRIM(:model)) AND LOWER(TRIM(product_name)) LIKE '%' || LOWER(TRIM(:color)) || '%'"
        ],
        "stdin": "{\"brand\":\"Helios\",\"series\":\"Professional\",\"model\":\"Helios 29A-FTE\",\"color\":\"White\"}"
      },
      "bind": "$catalog_matches_text"
    }
  ],
  "rowsets": [
    {
      "from_": "$catalog_matches_text",
      "format": "auto_delim",
      "into": "$catalog_matches",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_name",
          "candidates": [
            "product_name"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$catalog_matches"
      ],
      "into": "$match_count"
    },
    {
      "prim": "first",
      "args": [
        "$catalog_matches"
      ],
      "into": "$first_match"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "gt",
          "lhs": "$match_count",
          "rhs": "0",
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "<YES> — {first_match.product_name} ({first_match.product_sku}) is in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$first_match.record_path"
      ]
    },
    "not_found": {
      "message": "<NO> — the specified product does not exist in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}