{
  "objective": "Resolve the stuck card verification for basket basket_220 so the checkout can complete.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "basket_id": "basket_220",
    "basket": "lookup from shopping_baskets where basket_id = $basket_id",
    "payment": "lookup from payment_transactions where basket_id = $basket_id"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_DENIED_SECURITY"
  ],
  "constraints": [
    {
      "anchor": "#guest-restrictions",
      "rule": "Guests may not modify baskets or payments.",
      "security": true,
      "deny_when": {
        "op": "eq",
        "lhs": "$_facts.identity.kind",
        "rhs": "guest",
        "args": []
      }
    }
  ],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "and",
        "lhs": null,
        "rhs": null,
        "args": [
          {
            "op": "eq",
            "lhs": "$payment.payment_status",
            "rhs": "completed",
            "args": []
          },
          {
            "op": "eq",
            "lhs": "$payment.three_ds_status",
            "rhs": "successful",
            "args": []
          }
        ]
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "Basket {basket_id} is now ready for checkout. Payment verification completed."
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "policy_doc",
        "path": "/docs/payments/3ds.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$payment.record_path"
      }
    ],
    "OUTCOME_DENIED_SECURITY": [
      {
        "kind": "policy_doc",
        "path": "/docs/security.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ]
  }
}