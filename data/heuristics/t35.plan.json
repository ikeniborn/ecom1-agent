{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "policy_3ds"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "policy_security"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "policy_checkout"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT 'guest' AS kind, NULL AS customer_id"
      },
      "bind": "identity_rowset"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT * FROM payment_transactions WHERE payment_id = 'pay_021'"
      },
      "bind": "payment_rowset"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT * FROM shopping_baskets WHERE basket_id = 'basket_221'"
      },
      "bind": "basket_rowset"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$identity_rowset",
        0
      ],
      "into": "identity_row"
    },
    {
      "prim": "get",
      "args": [
        "$identity_row",
        "kind"
      ],
      "into": "identity_kind"
    },
    {
      "prim": "get",
      "args": [
        "$payment_rowset",
        0
      ],
      "into": "payment_row"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "record_path"
      ],
      "into": "payment_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "payment_status"
      ],
      "into": "payment_status"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_status"
      ],
      "into": "three_ds_status"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_attempts"
      ],
      "into": "three_ds_attempts"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_max_attempts"
      ],
      "into": "three_ds_max_attempts"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "payment_id"
      ],
      "into": "payment_id"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "basket_id"
      ],
      "into": "payment_basket_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket_rowset",
        0
      ],
      "into": "basket_row"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "basket_status"
      ],
      "into": "basket_status"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$identity_kind",
              "rhs": "guest",
              "args": []
            },
            {
              "op": "isnull",
              "lhs": "$identity_kind",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "denied_security"
      },
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "isnull",
              "lhs": "$payment_record_path",
              "rhs": null,
              "args": []
            },
            {
              "op": "ne",
              "lhs": "$payment_status",
              "rhs": "requires_3ds_action",
              "args": []
            },
            {
              "op": "not",
              "lhs": null,
              "rhs": null,
              "args": [
                {
                  "op": "in_set",
                  "lhs": "$three_ds_status",
                  "rhs": [
                    "status2",
                    "status3"
                  ],
                  "args": []
                }
              ]
            },
            {
              "op": "ge",
              "lhs": "$three_ds_attempts",
              "rhs": "$three_ds_max_attempts",
              "args": []
            },
            {
              "op": "ne",
              "lhs": "$basket_status",
              "rhs": "checked_out",
              "args": []
            },
            {
              "op": "ne",
              "lhs": "$payment_basket_id",
              "rhs": "basket_221",
              "args": []
            }
          ]
        },
        "label": "unsupported"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Security policy prevents 3DS recovery for guest users.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "unsupported": {
      "message": "Payment {payment_id} is not eligible for 3DS recovery.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "ok": {
      "message": "Recovered 3DS flow for payment {payment_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}