{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT payment_status, three_ds_status, three_ds_attempts, three_ds_max_attempts, record_path FROM payment_transactions WHERE payment_id = 'pay_041';"
      },
      "bind": "payment_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "identity_raw",
      "format": "auto_delim",
      "into": "identity_rows",
      "columns": [
        {
          "into": "kind",
          "candidates": [
            "kind"
          ]
        }
      ]
    },
    {
      "from_": "payment_raw",
      "format": "auto_delim",
      "into": "payment_rows",
      "columns": [
        {
          "into": "payment_status",
          "candidates": [
            "payment_status"
          ]
        },
        {
          "into": "three_ds_status",
          "candidates": [
            "three_ds_status"
          ]
        },
        {
          "into": "three_ds_attempts",
          "candidates": [
            "three_ds_attempts"
          ]
        },
        {
          "into": "three_ds_max_attempts",
          "candidates": [
            "three_ds_max_attempts"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "to_number",
      "args": [
        "$payment_rows.0.three_ds_attempts"
      ],
      "into": "three_ds_attempts_num"
    },
    {
      "prim": "to_number",
      "args": [
        "$payment_rows.0.three_ds_max_attempts"
      ],
      "into": "three_ds_max_attempts_num"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity_rows.0.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$payment_rows.0.payment_status",
              "rhs": "pending",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$payment_rows.0.three_ds_status",
              "rhs": "failed",
              "args": []
            },
            {
              "op": "lt",
              "lhs": "$three_ds_attempts_num",
              "rhs": "$three_ds_max_attempts_num",
              "args": []
            }
          ]
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/payments",
        "args": [
          "recover-3ds",
          "pay_041"
        ]
      },
      "bind": null,
      "guard_label": "ok",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "denied_security": {
      "message": "Guest not permitted to modify payment.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_rows.0.record_path"
        }
      ]
    },
    "ok": {
      "message": "3DS flow recovered for payment pay_041.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_rows.0.record_path"
        }
      ]
    },
    "unsupported": {
      "message": "3DS recovery not eligible.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        }
      ]
    }
  },
  "custom_extract": []
}