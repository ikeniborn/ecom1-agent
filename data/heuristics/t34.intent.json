{
  "objective": "Check out basket basket_001 for customer Nils Kramer (nils.kramer+cust553@outlook.com) by executing the checkout workflow.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "basket_id": "literal 'basket_001' from instruction",
    "customer_email": "literal 'nils.kramer+cust553@outlook.com' from instruction"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_DENIED_SECURITY",
    "OUTCOME_NONE_CLARIFICATION",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [
    {
      "anchor": "#security",
      "rule": "Only customers may check out their own baskets. Guests may not perform checkout on behalf of customers.",
      "security": true,
      "deny_when": {
        "op": "eq",
        "lhs": "$_facts.identity.kind",
        "rhs": "guest",
        "args": []
      },
      "requires_protected_action": false,
      "protected_action": false,
      "unsupported_when": null,
      "clarify_when": null,
      "refs": []
    }
  ],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$payment_transaction.payment_id",
        "rhs": null,
        "args": []
      },
      {
        "op": "eq",
        "lhs": "$basket.basket_status",
        "rhs": "checked_out",
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "Checkout completed for basket {basket_id} for customer {customer_email}.",
    "kind": "",
    "columns": [],
    "rows_from": ""
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      },
      {
        "kind": "policy_doc",
        "path": "/docs/security.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$payment_transaction.record_path"
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ]
  }
}