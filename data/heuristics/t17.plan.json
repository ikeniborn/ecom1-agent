{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH product_family AS (\n  SELECT product_family_id\n  FROM product_families\n  WHERE brand = 'Heco'\n    AND series = 'Heco Zinc Plated'\n    AND model = 'HECO 3DW-64B'\n    AND product_family_name = 'Nut Bolt and Washer'\n),\nproduct_variant AS (\n  SELECT pv.product_sku, pv.record_path\n  FROM product_variants pv\n  JOIN product_family pf ON pv.product_family_id = pf.product_family_id\n  JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku\n  WHERE pvp.property_key = 'fastener type'\n    AND pvp.property_value_text = 'threaded rod'\n),\ngraz_stores AS (\n  SELECT store_id\n  FROM stores\n  WHERE city = 'Graz'\n)\nSELECT pv.product_sku, pv.record_path AS product_record_path,\n       COALESCE(SUM(si.available_today_quantity), 0) AS total_available\nFROM graz_stores gs\nCROSS JOIN product_variant pv\nLEFT JOIN store_inventory si ON gs.store_id = si.store_id AND si.product_sku = pv.product_sku\nGROUP BY pv.product_sku, pv.record_path;"
      },
      "bind": "product_query"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM stores WHERE city = 'Graz';"
      },
      "bind": "store_query"
    }
  ],
  "rowsets": [
    {
      "from_": "$product_query.stdout",
      "format": "auto_delim",
      "into": "product_rowset",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_record_path",
          "candidates": [
            "product_record_path"
          ]
        },
        {
          "into": "total_available",
          "candidates": [
            "total_available"
          ]
        }
      ]
    },
    {
      "from_": "$store_query.stdout",
      "format": "auto_delim",
      "into": "store_rowset",
      "columns": [
        {
          "into": "store_record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "column",
      "args": [
        "$product_rowset",
        "product_record_path"
      ],
      "into": "product_record_paths_list"
    },
    {
      "prim": "first",
      "args": [
        "$product_record_paths_list"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "first",
      "args": [
        "$product_record_paths_list"
      ],
      "into": "product_variant.record_path"
    },
    {
      "prim": "column",
      "args": [
        "$product_rowset",
        "total_available"
      ],
      "into": "total_available_list"
    },
    {
      "prim": "first",
      "args": [
        "$total_available_list"
      ],
      "into": "count"
    },
    {
      "prim": "column",
      "args": [
        "$store_rowset",
        "store_record_path"
      ],
      "into": "store_record_paths"
    },
    {
      "prim": "count",
      "args": [
        "$store_record_paths"
      ],
      "into": "num_stores_in_graz"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_rowset",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$store_rowset",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "count: {count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "product_variant.record_path",
        "store_record_paths"
      ]
    },
    "unsupported": {
      "message": "Product or stores not found",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}