{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH product AS (SELECT pv.product_sku, pv.record_path AS product_record_path FROM product_variants pv JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku WHERE pv.brand = :brand AND pv.series = :series AND pv.model = :model AND pvp.property_key = :prop_key AND pvp.property_value_text = :prop_val LIMIT 1), stores_graz AS (SELECT store_id FROM stores WHERE city = :city), inventory_sum AS (SELECT COALESCE(SUM(si.available_today_quantity), 0) AS total_available FROM stores_graz sg LEFT JOIN store_inventory si ON si.store_id = sg.store_id AND si.product_sku = (SELECT product_sku FROM product)) SELECT (SELECT product_sku FROM product) AS product_sku, (SELECT product_record_path FROM product) AS product_record_path, (SELECT total_available FROM inventory_sum) AS total_available, (SELECT COUNT(*) FROM stores_graz) AS store_count",
        "args": {
          "brand": "Festool",
          "series": "Festool Stackable SYS 3JJ-9LM Tool Box and Bag",
          "model": "Tool Box and Bag",
          "prop_key": "storage type",
          "prop_val": "tool bag",
          "city": "Graz"
        }
      },
      "bind": "product_inventory"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT store_id, record_path FROM stores WHERE city = :city",
        "args": {
          "city": "Graz"
        }
      },
      "bind": "stores_result"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$product_inventory",
        "rows"
      ],
      "into": "product_inventory_rows"
    },
    {
      "prim": "first",
      "args": [
        "$product_inventory_rows"
      ],
      "into": "product_inventory_row"
    },
    {
      "prim": "get",
      "args": [
        "$product_inventory_row",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_inventory_row",
        "product_record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$product_inventory_row",
        "total_available"
      ],
      "into": "total_available"
    },
    {
      "prim": "get",
      "args": [
        "$product_inventory_row",
        "store_count"
      ],
      "into": "store_count"
    },
    {
      "prim": "get",
      "args": [
        "$stores_result",
        "rows"
      ],
      "into": "stores_rows"
    },
    {
      "prim": "column",
      "args": [
        "$stores_rows",
        "record_path"
      ],
      "into": "store_record_paths"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "ge",
              "lhs": "$store_count",
              "rhs": 1,
              "args": []
            }
          ]
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "answer={total_available}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$product_record_path",
        "$store_record_paths"
      ]
    },
    "unsupported": {
      "message": "Unable to determine availability for the specified product in Graz.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}