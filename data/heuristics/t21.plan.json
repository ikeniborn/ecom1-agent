{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Checkout denied: guests may not perform checkout.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "unsupported": {
      "message": "Checkout not supported for this user.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}