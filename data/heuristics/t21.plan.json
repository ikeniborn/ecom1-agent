{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_policy"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT basket_id, customer_id, basket_status, record_path FROM shopping_baskets WHERE basket_id = 'basket_190';"
      },
      "bind": "basket_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "basket_raw",
      "format": "auto_delim",
      "into": "basket_rows",
      "columns": [
        {
          "into": "basket_id",
          "candidates": [
            "basket_id"
          ]
        },
        {
          "into": "customer_id",
          "candidates": [
            "customer_id"
          ]
        },
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$basket_rows"
      ],
      "into": "basket"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$_facts.identity.kind",
              "rhs": "customer",
              "args": []
            },
            {
              "op": "ne",
              "lhs": "$basket.customer_id",
              "rhs": "$_facts.identity.customer_id",
              "args": []
            }
          ]
        },
        "label": "denied_security"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$_facts.identity.kind",
          "rhs": "customer",
          "args": []
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$basket.basket_status",
          "rhs": "active",
          "args": []
        },
        "label": "unsupported"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Checkout denied: basket {basket_id} does not belong to the current customer.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    },
    "unsupported": {
      "message": "Checkout is not supported for guest users. Basket {basket_id} cannot be processed.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    },
    "ok": {
      "message": "Checkout processed for basket {basket_id} with outcome {outcome}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}