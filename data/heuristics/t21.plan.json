{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_doc"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Checkout is not permitted for guest users. Basket {basket_id} cannot be checked out.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "unsupported": {
      "message": "Unable to process checkout for basket {basket_id}.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}