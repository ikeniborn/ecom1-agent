{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(*) AS cnt FROM product_variants WHERE product_kind_id = 'nuts_bolts_washers';"
      },
      "bind": "sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_output",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "cnt",
          "candidates": [
            "cnt"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$rows.0",
        "cnt"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "[QTY:{count}]",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/current-updates/catalogue-counting-2025-06-22-nuts-bolts-washers.md",
          "source": null
        }
      ]
    }
  },
  "custom_extract": []
}