{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [],
        "stdin": "SELECT k.product_kind_id AS kind_id, COUNT(v.product_sku) AS product_count, MIN(v.record_path) AS sample_path FROM product_kinds k LEFT JOIN product_variants v ON v.product_kind_id = k.product_kind_id WHERE k.product_kind_name = 'Nut Bolt and Washer' GROUP BY k.product_kind_id;"
      },
      "bind": "raw_count"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_count",
      "format": "auto_delim",
      "into": "count_rows",
      "columns": [
        {
          "into": "kind_id",
          "candidates": [
            "kind_id",
            "product_kind_id"
          ]
        },
        {
          "into": "product_count",
          "candidates": [
            "product_count",
            "COUNT(v.product_sku)"
          ]
        },
        {
          "into": "sample_path",
          "candidates": [
            "sample_path",
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$count_rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "kind_id"
      ],
      "into": "kind_id"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "sample_path"
      ],
      "into": "sample_path"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "product_count"
      ],
      "into": "product_count_raw"
    },
    {
      "prim": "to_number",
      "args": [
        "$product_count_raw"
      ],
      "into": "product_count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$kind_id",
          "rhs": null,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{product_count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$sample_path"
      ]
    },
    "unsupported": {
      "message": "No product kind named 'Nut Bolt and Washer' exists in the catalogue.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}