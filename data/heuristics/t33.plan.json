          ]
        },
        {
          "into": "store_count",
          "candidates": [
            "store_count"
          ]
        },
        {
          "into": "store_record_path",
          "candidates": [
            "store_record_path"
          ]
        },
        {
          "into": "total_count",
          "candidates": [
            "total_count"
          ]
        }
      ]
    }
  ],
