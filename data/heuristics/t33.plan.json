{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT product_sku, record_path FROM product_variants WHERE brand = 'Engelbert Strauss' AND series = 'e.s.vision' AND model = 'e.s. 150-ZC6 Work Top' AND product_sku IN (SELECT product_sku FROM product_variant_properties WHERE property_key = 'garment type' AND property_value_text = 'polo shirt')"
      },
      "bind": "product_info_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COALESCE((SELECT SUM(available_today_quantity) FROM store_inventory WHERE store_id IN (SELECT store_id FROM stores WHERE city = 'Graz' AND store_name LIKE '%PowerTool%') AND product_sku = '$product_sku'), 0) AS total_available"
      },
      "bind": "total_available_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM stores WHERE city = 'Graz' AND store_name LIKE '%PowerTool%'"
      },
      "bind": "store_paths_text"
    }
  ],
  "rowsets": [
    {
      "from_": "product_info_text",
      "format": "auto_delim",
      "into": "product_info_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "total_available_text",
      "format": "auto_delim",
      "into": "total_available_rows",
      "columns": [
        {
          "into": "total_available",
          "candidates": [
            "total_available"
          ]
        }
      ]
    },
    {
      "from_": "store_paths_text",
      "format": "auto_delim",
      "into": "store_paths_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_info_rows"
      ],
      "into": "product_info_first"
    },
    {
      "prim": "get",
      "args": [
        "$product_info_first",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_info_first",
        "record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "first",
      "args": [
        "$total_available_rows"
      ],
      "into": "total_available_first"
    },
    {
      "prim": "get",
      "args": [
        "$total_available_first",
        "total_available"
      ],
      "into": "total_available"
    },
    {
      "prim": "column",
      "args": [
        "$store_paths_rows",
        "record_path"
      ],
      "into": "store_record_paths"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$product_record_path",
          "rhs": null,
          "args": []
        },
        "label": "denied_missing_product"
      },
      {
        "when": {
          "op": "not",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$store_record_paths",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "denied_missing_stores"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "denied_missing_product": {
      "message": "Product not found",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "denied_missing_stores": {
      "message": "No PowerTool stores found in Graz",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "ok": {
      "message": "report count {total_available}",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}