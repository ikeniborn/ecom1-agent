{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH product_family AS (SELECT product_family_id FROM product_families WHERE brand = 'Hager' AND product_family_name LIKE '%HAG 1RH-81U%'), variant AS (SELECT product_sku, record_path FROM product_variants WHERE product_family_id IN (SELECT product_family_id FROM product_family) AND brand = 'Hager'), color_match AS (SELECT product_sku FROM product_variant_properties WHERE property_key = 'Color Family' AND property_value_text = 'Gray'), length_match AS (SELECT product_sku FROM product_variant_properties WHERE property_key = 'Length' AND property_value_text = '2 m'), product AS (SELECT v.product_sku, v.record_path FROM variant v JOIN color_match c ON v.product_sku = c.product_sku JOIN length_match l ON v.product_sku = l.product_sku) SELECT product_sku, record_path FROM product;"
      },
      "bind": "product_data"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT store_id, record_path FROM stores WHERE city = 'Graz';"
      },
      "bind": "stores_data"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COALESCE(SUM(available_today_quantity), 0) AS total_available FROM store_inventory WHERE store_id IN (SELECT store_id FROM stores WHERE city = 'Graz') AND product_sku = :product_sku;"
      },
      "bind": "total_data"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$product_data",
        "rows"
      ],
      "into": "product_rows"
    },
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "product_row"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$stores_data",
        "rows"
      ],
      "into": "store_rows"
    },
    {
      "prim": "column",
      "args": [
        "$store_rows",
        "record_path"
      ],
      "into": "store_record_paths"
    },
    {
      "prim": "column",
      "args": [
        "$store_rows",
        "store_id"
      ],
      "into": "store_ids"
    },
    {
      "prim": "get",
      "args": [
        "$total_data",
        "rows"
      ],
      "into": "total_rows"
    },
    {
      "prim": "first",
      "args": [
        "$total_rows"
      ],
      "into": "total_row"
    },
    {
      "prim": "get",
      "args": [
        "$total_row",
        "total_available"
      ],
      "into": "total_available"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$store_record_paths",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "answer: {total_available}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$product_record_path",
        "$store_record_paths"
      ]
    },
    "not_found": {
      "message": "Product not found or no stores in Graz.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}