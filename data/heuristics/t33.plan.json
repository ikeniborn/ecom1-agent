{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH product AS (SELECT product_sku, record_path FROM product_variants WHERE brand='Uvex' AND series='Uvex Industrial' AND model='uvex 2KV-937 Work Gloves' AND EXISTS (SELECT 1 FROM product_variant_properties WHERE product_sku=product_variants.product_sku AND property_key='Size' AND property_value_text='L') AND EXISTS (SELECT 1 FROM product_variant_properties WHERE product_sku=product_variants.product_sku AND property_key='Color Family' AND property_value_text='Blue')), stores AS (SELECT store_id, record_path FROM stores WHERE city='Vienna' AND is_open=1) SELECT (SELECT product_sku FROM product) AS product_sku, (SELECT record_path FROM product) AS product_record_path, (SELECT COUNT(*) FROM stores) AS store_count, (SELECT record_path FROM stores LIMIT 1) AS store_record_path, COALESCE((SELECT SUM(available_today_quantity) FROM store_inventory WHERE product_sku IN (SELECT product_sku FROM product) AND store_id IN (SELECT store_id FROM stores)), 0) AS total_count;"
      },
      "bind": "result_raw"
    }
  ],
