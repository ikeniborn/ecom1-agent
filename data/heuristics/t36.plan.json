{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/store-associate-exception-handbook.md"
      },
      "bind": "handbook_raw"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$handbook_raw",
        "text"
      ],
      "into": "handbook_text"
    }
  ],
  "decision": {
    "branches": [],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "unsupported": {
      "message": "Exception '{params.exception_name}' is not documented in the Store Associate Exception Handbook for basket {params.basket_id}.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}