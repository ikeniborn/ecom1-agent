{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "$raw_identity"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "$security_doc_raw"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/store-associate-exception-handbook.md"
      },
      "bind": "$handbook_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "$raw_identity",
      "format": "json",
      "into": "$_facts.identity",
      "columns": []
    },
    {
      "from_": "$handbook_raw",
      "format": "auto_delim",
      "into": "$handbook_lines",
      "columns": [
        {
          "into": "line",
          "candidates": [
            "line"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "filter_rows",
      "args": [
        "$handbook_lines",
        {
          "op": "contains_any",
          "lhs": "$line",
          "rhs": [
            "queue-save quick complete"
          ]
        }
      ],
      "into": "$matching_lines"
    },
    {
      "prim": "first",
      "args": [
        "$matching_lines"
      ],
      "into": "$first_match"
    },
    {
      "prim": "column",
      "args": [
        "$first_match",
        "line"
      ],
      "into": "$handbook_exception_section"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      },
      {
        "when": {
          "op": "not",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$handbook_exception_section",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "unsupported"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Guest access denied for store associate exception.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": "$security_doc_raw"
        }
      ]
    },
    "unsupported": {
      "message": "The 'queue-save quick complete' exception is not supported by the Store Associate Exception Handbook.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/store-associate-exception-handbook.md",
          "source": "$handbook_raw"
        }
      ]
    }
  },
  "custom_extract": []
}