{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM shopping_baskets WHERE basket_id = 'basket_004';"
      },
      "bind": "$basket_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "$basket_raw",
      "format": "auto_delim",
      "into": "$basket_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$basket_rows"
      ],
      "into": "$basket"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "deny"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "deny": {
      "message": "Discount application denied: security policy requires authenticated user.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "ok": {
      "message": "Applied 10% service_recovery discount to basket {basket_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/discounts.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}