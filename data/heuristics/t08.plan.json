{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH family AS (SELECT product_family_id FROM product_families WHERE brand='Fiskars' AND series='Smart FSK 2WT-RQL' AND model='Manual Garden Tool'), variant AS (SELECT product_sku, record_path, product_name FROM product_variants WHERE product_family_id IN (SELECT product_family_id FROM family)), base_prop AS (SELECT COUNT(*) AS base_count FROM product_variant_properties WHERE product_sku IN (SELECT product_sku FROM variant) AND property_key='tool_type' AND property_value_text='soil cultivator'), length_prop AS (SELECT COUNT(*) AS length_count FROM product_variant_properties WHERE product_sku IN (SELECT product_sku FROM variant) AND property_key='length' AND property_value_text='900 mm'), extra_prop AS (SELECT COUNT(*) AS extra_count FROM product_variant_properties WHERE product_sku IN (SELECT product_sku FROM variant) AND property_key='tool_type' AND property_value_text='pruning saw') SELECT json_array(json_object('sku', (SELECT product_sku FROM variant LIMIT 1), 'record_path', (SELECT record_path FROM variant LIMIT 1), 'base_ok', (SELECT base_count FROM base_prop), 'length_ok', (SELECT length_count FROM length_prop), 'extra_ok', (SELECT extra_count FROM extra_prop)));"
      },
      "bind": "raw_sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_output",
      "format": "json",
      "into": "parsed_rows",
      "columns": []
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$parsed_rows"
      ],
      "into": "row_dict"
    },
    {
      "prim": "get",
      "args": [
        "$row_dict",
        "sku"
      ],
      "into": "sku"
    },
    {
      "prim": "get",
      "args": [
        "$row_dict",
        "record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$row_dict",
        "base_ok"
      ],
      "into": "base_ok"
    },
    {
      "prim": "get",
      "args": [
        "$row_dict",
        "length_ok"
      ],
      "into": "length_ok"
    },
    {
      "prim": "get",
      "args": [
        "$row_dict",
        "extra_ok"
      ],
      "into": "extra_ok"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "isnull",
              "lhs": "$sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$sku",
              "rhs": "",
              "args": []
            }
          ]
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "or",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$base_ok",
              "rhs": 0,
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$length_ok",
              "rhs": 0,
              "args": []
            }
          ]
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "gt",
          "lhs": "$extra_ok",
          "rhs": 0,
          "args": []
        },
        "label": "verified"
      }
    ],
    "default_label": "no_extra"
  },
  "ops": [],
  "answer": {
    "unsupported": {
      "message": "Answer: UNSUPPORTED SKU: {sku}",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "verified": {
      "message": "Answer: Verified SKU: {sku}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        }
      ]
    },
    "no_extra": {
      "message": "Answer: <NO> SKU: {sku}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}