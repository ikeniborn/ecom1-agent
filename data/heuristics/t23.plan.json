{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_doc"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_doc"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/proc/baskets/basket_008.json"
      },
      "bind": "basket_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT '/proc/payments/pay_' || :basket_id || '.json' AS record_path;"
      },
      "bind": "payment_record_path_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH inv AS (SELECT available_today_quantity FROM store_inventory WHERE store_id = :store_id AND product_sku = :sku), price AS (SELECT price_cents FROM product_variants WHERE product_sku = :sku) SELECT inv.available_today_quantity, price.price_cents FROM inv, price;"
      },
      "bind": "inventory_price_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "basket_raw",
      "format": "json",
      "into": "basket_rows",
      "columns": []
    },
    {
      "from_": "payment_record_path_raw",
      "format": "auto_delim",
      "into": "payment_record_path_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "inventory_price_raw",
      "format": "auto_delim",
      "into": "inventory_price_rows",
      "columns": [
        {
          "into": "available_today_quantity",
          "candidates": [
            "available_today_quantity"
          ]
        },
        {
          "into": "price_cents",
          "candidates": [
            "price_cents"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$basket_rows"
      ],
      "into": "basket"
    },
    {
      "prim": "get",
      "args": [
        "$basket",
        "customer_id"
      ],
      "into": "basket_customer_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket",
        "basket_status"
      ],
      "into": "basket_status"
    },
    {
      "prim": "get",
      "args": [
        "$basket",
        "store_id"
      ],
      "into": "basket_store_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket",
        "items"
      ],
      "into": "basket_items"
    },
    {
      "prim": "first",
      "args": [
        "$basket_items"
      ],
      "into": "first_item"
    },
    {
      "prim": "get",
      "args": [
        "$first_item",
        "product_sku"
      ],
      "into": "sku"
    },
    {
      "prim": "get",
      "args": [
        "$first_item",
        "requested_quantity"
      ],
      "into": "qty"
    },
    {
      "prim": "first",
      "args": [
        "$payment_record_path_rows"
      ],
      "into": "payment_record_path_row"
    },
    {
      "prim": "get",
      "args": [
        "$payment_record_path_row",
        "record_path"
      ],
      "into": "payment_record_path"
    },
    {
      "prim": "count",
      "args": [
        "$inventory_price_rows"
      ],
      "into": "inv_count"
    },
    {
      "prim": "first",
      "args": [
        "$inventory_price_rows"
      ],
      "into": "inv_price"
    },
    {
      "prim": "get",
      "args": [
        "$inv_price",
        "available_today_quantity"
      ],
      "into": "available_qty"
    },
    {
      "prim": "get",
      "args": [
        "$inv_price",
        "price_cents"
      ],
      "into": "price_cents"
    },
    {
      "prim": "to_number",
      "args": [
        "$qty"
      ],
      "into": "qty_num"
    },
    {
      "prim": "to_number",
      "args": [
        "$available_qty"
      ],
      "into": "avail_num"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ne",
          "lhs": "$basket_customer_id",
          "rhs": "cust_028",
          "args": []
        },
        "label": "deny_constraints"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$basket_status",
          "rhs": "open",
          "args": []
        },
        "label": "deny_constraints"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$inv_count",
          "rhs": "0",
          "args": []
        },
        "label": "deny_inventory"
      },
      {
        "when": {
          "op": "gt",
          "lhs": "$qty_num",
          "rhs": "$avail_num",
          "args": []
        },
        "label": "deny_inventory"
      }
    ],
    "default_label": "create_payment"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "BEGIN; INSERT INTO payment_transactions (payment_id, record_path, basket_id, is_archived_basket_reference, customer_id, store_id, payment_amount_cents, payment_currency, payment_status, payment_created_at, payment_method_fingerprint, device_fingerprint, observed_latitude, observed_longitude) SELECT 'pay_' || :basket_id, '/proc/payments/pay_' || :basket_id || '.json', :basket_id, 0, :customer_id, :store_id, :qty * pv.price_cents, 'USD', 'completed', datetime('now'), 'disabled', 'disabled', 0.0, 0.0 FROM product_variants pv WHERE pv.product_sku = :sku; UPDATE shopping_baskets SET basket_status = 'checked_out' WHERE basket_id = :basket_id; COMMIT;"
      },
      "bind": null,
      "guard_label": "create_payment",
      "outcome_from_exit": {
        "ok_outcome": "OUTCOME_OK",
        "keyword_buckets": [],
        "default_outcome": "OUTCOME_ERR_INTERNAL"
      }
    }
  ],
  "answer": {
    "deny_constraints": {
      "message": "Checkout denied: basket does not belong to customer or is not open.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        }
      ]
    },
    "deny_inventory": {
      "message": "Checkout denied: insufficient inventory.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        }
      ]
    },
    "create_payment": {
      "message": "Checkout completed for basket {basket_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}