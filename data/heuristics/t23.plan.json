{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_policy"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH basket AS (SELECT basket_status, store_id, customer_id, record_path FROM shopping_baskets WHERE basket_id = 'basket_051'), items AS (SELECT product_sku, requested_quantity FROM shopping_basket_items WHERE basket_id = 'basket_051'), inventory AS (SELECT si.product_sku, si.available_today_quantity FROM store_inventory si WHERE si.store_id = (SELECT store_id FROM basket)), issues AS (SELECT COUNT(*) AS issue_count FROM items i LEFT JOIN inventory inv ON i.product_sku = inv.product_sku WHERE inv.product_sku IS NULL OR i.requested_quantity > inv.available_today_quantity), store_customer AS (SELECT s.is_open, s.city AS store_city, c.home_city FROM stores s, customer_accounts c WHERE s.store_id = (SELECT store_id FROM basket) AND c.customer_id = (SELECT customer_id FROM basket)) SELECT b.basket_status, b.store_id, b.customer_id, b.record_path, i.issue_count, sc.is_open, sc.store_city, sc.home_city FROM basket b, issues i, store_customer sc;"
      },
      "bind": "basket_info_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "basket_info_raw",
      "format": "auto_delim",
      "into": "basket_info",
      "columns": [
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        },
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "customer_id",
          "candidates": [
            "customer_id"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "issue_count",
          "candidates": [
            "issue_count"
          ]
        },
        {
          "into": "is_open",
          "candidates": [
            "is_open"
          ]
        },
        {
          "into": "store_city",
          "candidates": [
            "store_city"
          ]
        },
        {
          "into": "home_city",
          "candidates": [
            "home_city"
          ]
        }
      ]
    }
  ],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ne",
          "lhs": "$basket_info.0.home_city",
          "rhs": "$basket_info.0.store_city",
          "args": []
        },
        "label": "security_denied"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$basket_info.0.basket_status",
          "rhs": "checked_out",
          "args": []
        },
        "label": "already_checked_out"
      },
      {
        "when": {
          "op": "gt",
          "lhs": "$basket_info.0.issue_count",
          "rhs": 0,
          "args": []
        },
        "label": "insufficient_inventory"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$basket_info.0.is_open",
          "rhs": 0,
          "args": []
        },
        "label": "store_closed"
      }
    ],
    "default_label": "proceed_checkout"
  },
  "ops": [
    {
      "rpc": "Write",
      "args": {
        "path": "/finalization/basket_051",
        "content": "{}"
      },
      "bind": null,
      "guard_label": "proceed_checkout",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "security_denied": {
      "message": "Security policy denied checkout for guest customer.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "already_checked_out": {
      "message": "Basket {basket_id} is already checked out.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "insufficient_inventory": {
      "message": "Insufficient inventory for basket {basket_id}.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "store_closed": {
      "message": "Store is closed.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "proceed_checkout": {
      "message": "Checkout completed for basket {basket_id} for customer {customer_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md"
        },
        {
          "kind": "record_path",
          "path": "$basket_info.0.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}