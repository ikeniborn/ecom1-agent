{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_policy"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_policy"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH basket AS (SELECT basket_id, store_id, customer_id, basket_status FROM shopping_baskets WHERE basket_id = 'basket_035'), items AS (SELECT product_sku, requested_quantity FROM shopping_basket_items WHERE basket_id = 'basket_035'), inventory AS (SELECT si.product_sku, si.available_today_quantity FROM store_inventory si JOIN basket b ON si.store_id = b.store_id WHERE si.product_sku IN (SELECT product_sku FROM items)), prices AS (SELECT pv.product_sku, pv.price_cents FROM product_variants pv WHERE pv.product_sku IN (SELECT product_sku FROM items)), payment_exists AS (SELECT COUNT(*) as cnt FROM payment_transactions WHERE basket_id = 'basket_035' AND payment_status = 'completed') SELECT b.basket_status, b.store_id, b.customer_id, CASE WHEN MIN(i.available_today_quantity - it.requested_quantity) >= 0 THEN 1 ELSE 0 END as sufficient_inventory, CASE WHEN pe.cnt > 0 THEN 1 ELSE 0 END as payment_exists, SUM(p.price_cents * it.requested_quantity) as total_amount_cents FROM basket b CROSS JOIN items it JOIN inventory i ON it.product_sku = i.product_sku JOIN prices p ON it.product_sku = p.product_sku CROSS JOIN payment_exists pe GROUP BY b.basket_status, b.store_id, b.customer_id, pe.cnt;"
      },
      "bind": "basket_data_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT hex(randomblob(16)) as payment_id;"
      },
      "bind": "payment_id_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "identity_raw",
      "format": "json",
      "into": "identity_parsed",
      "columns": []
    },
    {
      "from_": "basket_data_raw",
      "format": "auto_delim",
      "into": "basket_rows",
      "columns": [
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        },
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "customer_id",
          "candidates": [
            "customer_id"
          ]
        },
        {
          "into": "sufficient_inventory",
          "candidates": [
            "sufficient_inventory"
          ]
        },
        {
          "into": "payment_exists",
          "candidates": [
            "payment_exists"
          ]
        },
        {
          "into": "total_amount_cents",
          "candidates": [
            "total_amount_cents"
          ]
        }
      ]
    },
    {
      "from_": "payment_id_raw",
      "format": "auto_delim",
      "into": "payment_id_rows",
      "columns": [
        {
          "into": "payment_id",
          "candidates": [
            "payment_id"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$identity_parsed",
        "kind"
      ],
      "into": "identity_kind"
    },
    {
      "prim": "first",
      "args": [
        "$basket_rows"
      ],
      "into": "basket_row"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "basket_status"
      ],
      "into": "basket_status"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "store_id"
      ],
      "into": "store_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "customer_id"
      ],
      "into": "customer_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "sufficient_inventory"
      ],
      "into": "sufficient_inventory"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "payment_exists"
      ],
      "into": "payment_exists"
    },
    {
      "prim": "get",
      "args": [
        "$basket_row",
        "total_amount_cents"
      ],
      "into": "total_amount_cents"
    },
    {
      "prim": "first",
      "args": [
        "$payment_id_rows"
      ],
      "into": "payment_id_row"
    },
    {
      "prim": "get",
      "args": [
        "$payment_id_row",
        "payment_id"
      ],
      "into": "payment_id"
    },
    {
      "prim": "concat",
      "args": [
        "/payments/",
        "$payment_id"
      ],
      "into": "payment_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity_kind",
          "rhs": "guest",
          "args": []
        },
        "label": "security_denied"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$payment_exists",
          "rhs": 1,
          "args": []
        },
        "label": "already_checked_out"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$sufficient_inventory",
          "rhs": 0,
          "args": []
        },
        "label": "insufficient_inventory"
      }
    ],
    "default_label": "proceed"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "UPDATE shopping_baskets SET basket_status = 'checked_out' WHERE basket_id = 'basket_035'; INSERT INTO payment_transactions (payment_id, record_path, basket_id, is_archived_basket_reference, customer_id, store_id, payment_amount_cents, payment_currency, payment_status, payment_created_at, payment_method_fingerprint, device_fingerprint, observed_latitude, observed_longitude) VALUES ('$payment_id', '$payment_record_path', 'basket_035', 0, '$customer_id', '$store_id', $total_amount_cents, 'USD', 'completed', datetime('now'), 'unknown', 'unknown', 0.0, 0.0);"
      },
      "bind": null,
      "guard_label": "proceed",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "security_denied": {
      "message": "Guest checkout not allowed.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "already_checked_out": {
      "message": "Basket already checked out.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    },
    "insufficient_inventory": {
      "message": "Insufficient inventory for some items.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    },
    "proceed": {
      "message": "Checkout completed for basket {basket_id}. Payment ID: {payment_id}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}