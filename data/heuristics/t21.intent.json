{
  "objective": "Check out the shopping basket identified by basket_190, processing payment and finalizing the order.",
  "desired_outcome": "OUTCOME_OK",
  "params": {
    "basket_id": "the basket_id provided in the instruction ('basket_190')"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_DENIED_SECURITY",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [
    {
      "anchor": "/docs/checkout.md#checkout-eligibility",
      "rule": "Only customers may checkout.",
      "security": false,
      "deny_when": {
        "op": "ne",
        "lhs": "$_facts.identity.kind",
        "rhs": "customer",
        "args": []
      }
    },
    {
      "anchor": "/docs/security.md#customer-ownership",
      "rule": "Customers may only access their own baskets.",
      "security": true,
      "deny_when": {
        "op": "and",
        "lhs": null,
        "rhs": null,
        "args": [
          {
            "op": "eq",
            "lhs": "$_facts.identity.kind",
            "rhs": "customer",
            "args": []
          },
          {
            "op": "ne",
            "lhs": "$basket.customer_id",
            "rhs": "$_facts.identity.customer_id",
            "args": []
          }
        ]
      }
    },
    {
      "anchor": "/docs/checkout.md#basket-status",
      "rule": "Basket must be in 'active' status to be checked out.",
      "security": false,
      "deny_when": {
        "op": "ne",
        "lhs": "$basket.basket_status",
        "rhs": "active",
        "args": []
      }
    }
  ],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$payment.payment_id",
        "rhs": null,
        "args": []
      },
      {
        "op": "eq",
        "lhs": "$payment.basket_id",
        "rhs": "$basket_id",
        "args": []
      },
      {
        "op": "eq",
        "lhs": "$payment.payment_status",
        "rhs": "completed",
        "args": []
      },
      {
        "op": "gt",
        "lhs": "$payment.payment_amount_cents",
        "rhs": 0,
        "args": []
      },
      {
        "op": "eq",
        "lhs": "$basket.basket_status",
        "rhs": "checked_out",
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "Checkout processed for basket {basket_id} with outcome {outcome}."
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$payment.record_path"
      }
    ],
    "OUTCOME_DENIED_SECURITY": [
      {
        "kind": "policy_doc",
        "path": "/docs/security.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ],
    "OUTCOME_NONE_UNSUPPORTED": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ]
  }
}