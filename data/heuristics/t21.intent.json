        "rhs": "guest",
        "args": []
      },
      "requires_protected_action": false,
      "protected_action": false,
      "unsupported_when": null,
      "clarify_when": null,
      "refs": []
    }
  ],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$payment_id",
        "rhs": null,
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "Checkout completed for basket {basket_id}.",
    "kind": "",
    "columns": [],
    "rows_from": ""
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$payment.record_path"
      }
    ]
  }
}