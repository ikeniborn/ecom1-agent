{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_doc"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_doc"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT 'pmt_basket_001' AS payment_id, '/payments/pmt_basket_001.json' AS record_path;"
      },
      "bind": "payment_id_rowset_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT c.customer_id, b.basket_status, b.store_id, s.latitude, s.longitude, (SELECT COUNT(*) FROM shopping_basket_items bi JOIN store_inventory si ON bi.product_sku = si.product_sku AND si.store_id = b.store_id WHERE bi.basket_id = 'basket_001' AND bi.requested_quantity > si.available_today_quantity) AS insufficient_items, (SELECT SUM(pv.price_cents * bi.requested_quantity) FROM shopping_basket_items bi JOIN product_variants pv ON bi.product_sku = pv.product_sku WHERE bi.basket_id = 'basket_001') AS total_amount_cents FROM customer_accounts c JOIN shopping_baskets b ON c.customer_id = b.customer_id JOIN stores s ON b.store_id = s.store_id WHERE c.customer_email = 'nils.kramer+cust553@outlook.com' AND b.basket_id = 'basket_001';"
      },
      "bind": "basket_check_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "payment_id_rowset_raw",
      "format": "auto_delim",
      "into": "payment_id_rows",
      "columns": [
        {
          "into": "payment_id",
          "candidates": [
            "payment_id"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "basket_check_raw",
      "format": "auto_delim",
      "into": "basket_check_rows",
      "columns": [
        {
          "into": "customer_id",
          "candidates": [
            "customer_id"
          ]
        },
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        },
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "latitude",
          "candidates": [
            "latitude"
          ]
        },
        {
          "into": "longitude",
          "candidates": [
            "longitude"
          ]
        },
        {
          "into": "insufficient_items",
          "candidates": [
            "insufficient_items"
          ]
        },
        {
          "into": "total_amount_cents",
          "candidates": [
            "total_amount_cents"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$payment_id_rows"
      ],
      "into": "first_payment_id_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_payment_id_row",
        "payment_id"
      ],
      "into": "payment_id"
    },
    {
      "prim": "get",
      "args": [
        "$first_payment_id_row",
        "record_path"
      ],
      "into": "payment_record_path"
    },
    {
      "prim": "first",
      "args": [
        "$basket_check_rows"
      ],
      "into": "first_basket_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "customer_id"
      ],
      "into": "customer_id"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "store_id"
      ],
      "into": "store_id"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "latitude"
      ],
      "into": "latitude"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "longitude"
      ],
      "into": "longitude"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "insufficient_items"
      ],
      "into": "insufficient_items_raw"
    },
    {
      "prim": "to_number",
      "args": [
        "$insufficient_items_raw"
      ],
      "into": "insufficient_items_num"
    },
    {
      "prim": "get",
      "args": [
        "$first_basket_row",
        "total_amount_cents"
      ],
      "into": "total_amount_cents_raw"
    },
    {
      "prim": "to_number",
      "args": [
        "$total_amount_cents_raw"
      ],
      "into": "amount_cents"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "regex_match",
          "lhs": "$security_doc",
          "rhs": "guest checkout denied",
          "args": []
        },
        "label": "security_denied"
      },
      {
        "when": {
          "op": "isnull",
          "lhs": "$customer_id",
          "rhs": null,
          "args": []
        },
        "label": "not_found_denied"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$insufficient_items_num",
          "rhs": 0,
          "args": []
        },
        "label": "inventory_denied"
      }
    ],
    "default_label": "proceed"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": ".param set :customer_id '$customer_id';\n.param set :store_id '$store_id';\n.param set :basket_id '$params.basket_id';\n.param set :total_amount_cents $amount_cents;\n.param set :latitude $latitude;\n.param set :longitude $longitude;\n.param set :payment_id 'pmt_basket_001';\n.param set :record_path '/payments/pmt_basket_001.json';\nBEGIN;\nUPDATE shopping_baskets SET basket_status = 'finalized' WHERE basket_id = :basket_id;\nINSERT INTO payment_transactions (payment_id, record_path, basket_id, is_archived_basket_reference, customer_id, store_id, payment_amount_cents, payment_currency, payment_status, payment_created_at, payment_method_fingerprint, device_fingerprint, observed_latitude, observed_longitude, three_ds_status) VALUES (:payment_id, :record_path, :basket_id, 0, :customer_id, :store_id, :total_amount_cents, 'USD', 'completed', datetime('now'), 'guest_checkout', 'guest', :latitude, :longitude, NULL);\nCOMMIT;"
      },
      "bind": null,
      "guard_label": "proceed",
      "outcome_from_exit": {
        "ok_outcome": "OUTCOME_OK",
        "keyword_buckets": [],
        "default_outcome": "OUTCOME_DENIED_SECURITY"
      }
    }
  ],
  "answer": {
    "security_denied": {
      "message": "Checkout denied: guest checkout not permitted by security policy.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "not_found_denied": {
      "message": "Checkout denied: customer or basket not found.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "inventory_denied": {
      "message": "Checkout denied: insufficient inventory for one or more items.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "proceed": {
      "message": "Checkout completed for basket {basket_id}. Payment ID: {payment_id}, amount: {amount_cents} cents.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}