{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(*) AS matching_count, MIN(v.record_path) AS product_record_path FROM product_variants v JOIN product_variant_properties p1 ON v.product_sku = p1.product_sku AND p1.property_key = 'fastener type' AND p1.property_value_text = 'bolt' JOIN product_variant_properties p2 ON v.product_sku = p2.product_sku AND p2.property_key = 'diameter' AND p2.property_value_text = '10 mm' WHERE v.brand = 'Heco' AND v.series = '3DW-64B' AND v.model = 'Nut Bolt and Washer';"
      },
      "bind": "sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_output",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "matching_count",
          "candidates": [
            "matching_count"
          ]
        },
        {
          "into": "product_record_path",
          "candidates": [
            "product_record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "matching_count"
      ],
      "into": "matching_count"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "product_record_path"
      ],
      "into": "product_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ge",
          "lhs": "$matching_count",
          "rhs": 1,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "The product exists in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        }
      ]
    },
    "not_found": {
      "message": "The product does not exist in the catalogue.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}