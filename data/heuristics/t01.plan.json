{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path FROM product_variants pv JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku WHERE pv.brand = 'Heco' AND pv.series = 'Heco Zinc Plated TopFix GTU-YPJ Wood and Drywall Screw' AND pvp.property_key = 'screw type' AND pvp.property_value_text = 'drywall screw';"
      },
      "bind": "raw_sql_result"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_result",
      "format": "auto_delim",
      "into": "candidate_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$candidate_rows"
      ],
      "into": "found_product"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$candidate_rows",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "The product is available in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$found_product.record_path"
        }
      ]
    },
    "not_found": {
      "message": "The product is not available in the catalogue.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}