{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [],
        "stdin": "SELECT product_sku, record_path FROM product_variants WHERE LOWER(TRIM(brand)) = 'heco' AND LOWER(TRIM(series)) = 'zinc plated' AND LOWER(TRIM(model)) = 'heco 3dw-64b' AND LOWER(product_name) LIKE '%nut bolt and washer%' AND LOWER(product_name) LIKE '% bolt 8mm%' LIMIT 1;"
      },
      "bind": "matched_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "matched_raw",
      "format": "auto_delim",
      "into": "matched_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku",
            "sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path",
            "path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$matched_rows"
      ],
      "into": "matched_candidate"
    },
    {
      "prim": "count",
      "args": [
        "$matched_rows"
      ],
      "into": "matched_candidate_count"
    },
    {
      "prim": "get",
      "args": [
        "$matched_candidate",
        "product_sku"
      ],
      "into": "product_sku"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "gt",
          "lhs": "$matched_candidate_count",
          "rhs": 0,
          "args": []
        },
        "label": "present"
      }
    ],
    "default_label": "absent"
  },
  "ops": [],
  "answer": {
    "present": {
      "message": "YES: Heco Zinc Plated HECO 3DW-64B Nut Bolt and Washer (fastener type bolt, 8 mm) — {product_sku}",
      "outcome": "OUTCOME_OK",
      "refs": []
    },
    "absent": {
      "message": "NO: Heco Zinc Plated HECO 3DW-64B Nut Bolt and Washer (fastener type bolt, 8 mm) — not in catalogue",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}