{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path, pv.product_name FROM product_variants pv JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku WHERE pv.brand ILIKE '%Heco%' AND pv.series ILIKE '%TopFix%' AND pv.model ILIKE '%GTU-YPJ%' AND pv.product_name ILIKE '%Wood%Drywall%Screw%' AND pvp.property_key = 'screw type' AND pvp.property_value_text ILIKE '%drywall screw%' LIMIT 1;"
      },
      "bind": "candidates_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "candidates_raw",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "product_name",
          "candidates": [
            "product_name"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "column",
      "args": [
        "$rows",
        "product_sku"
      ],
      "into": "sku_list"
    },
    {
      "prim": "first",
      "args": [
        "$sku_list"
      ],
      "into": "product_sku"
    },
    {
      "prim": "column",
      "args": [
        "$rows",
        "record_path"
      ],
      "into": "path_list"
    },
    {
      "prim": "first",
      "args": [
        "$path_list"
      ],
      "into": "record_path"
    },
    {
      "prim": "column",
      "args": [
        "$rows",
        "product_name"
      ],
      "into": "name_list"
    },
    {
      "prim": "first",
      "args": [
        "$name_list"
      ],
      "into": "product_name"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "nonempty",
              "lhs": "$record_path",
              "rhs": null,
              "args": []
            }
          ]
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "We carry {product_name} (SKU: {product_sku}).",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$record_path"
        }
      ]
    },
    "not_found": {
      "message": "We do not carry the Heco TopFix GTU-YPJ Wood and Drywall Screw with drywall screw type.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}