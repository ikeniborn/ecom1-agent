{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/README.md"
      },
      "bind": "docs_readme"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [
          ":brand=Heco",
          ":token=HECO 3DW-64B"
        ],
        "stdin": "SELECT record_path FROM product_variants WHERE LOWER(TRIM(brand)) = LOWER(TRIM(:brand)) AND (LOWER(TRIM(series)) LIKE '%' || LOWER(TRIM(:token)) || '%' OR LOWER(TRIM(model)) LIKE '%' || LOWER(TRIM(:token)) || '%') LIMIT 5"
      },
      "bind": "catalog_text"
    }
  ],
  "rowsets": [
    {
      "from_": "catalog_text",
      "format": "auto_delim",
      "into": "catalog_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$catalog_rows"
      ],
      "into": "match_count"
    },
    {
      "prim": "first",
      "args": [
        "$catalog_rows"
      ],
      "into": "first_record"
    },
    {
      "prim": "get",
      "args": [
        "$first_record",
        "record_path"
      ],
      "into": "first_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ge",
          "lhs": "$match_count",
          "rhs": 1,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "absent"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "Catalogue search result: <YES> (record_path: {first_record_path})",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$first_record_path"
      ]
    },
    "absent": {
      "message": "Catalogue search result: <NO>",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}