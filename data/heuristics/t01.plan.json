{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [],
        "stdin": "-c\nWITH candidates AS (\n  SELECT product_sku, product_name, record_path\n  FROM product_variants\n  WHERE brand ILIKE 'heco'\n    AND series ILIKE '%heco zinc plated heco 3dw-64b nut bolt and washer%'\n)\nSELECT c.product_sku, c.product_name, c.record_path\nFROM candidates c\nWHERE EXISTS (\n  SELECT 1 FROM product_variant_properties p\n  WHERE p.product_sku = c.product_sku AND p.property_key = 'fastener_type' AND p.property_value_text ILIKE 'bolt'\n)\nAND EXISTS (\n  SELECT 1 FROM product_variant_properties p\n  WHERE p.product_sku = c.product_sku AND p.property_key = 'diameter' AND p.property_value_text ILIKE '8 mm'\n);"
      },
      "bind": "candidates_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "candidates_raw",
      "format": "auto_delim",
      "into": "candidates_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_name",
          "candidates": [
            "product_name"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$candidates_rows"
      ],
      "into": "first_candidate"
    },
    {
      "prim": "get",
      "args": [
        "$first_candidate",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$first_candidate",
        "product_name"
      ],
      "into": "product_name"
    },
    {
      "prim": "get",
      "args": [
        "$first_candidate",
        "record_path"
      ],
      "into": "product_variant.record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$product_sku",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "Product {product_name} (SKU: {product_sku}) is available in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_variant.record_path"
        }
      ]
    },
    "not_found": {
      "message": "Product not found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}