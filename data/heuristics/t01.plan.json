{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM product_variants WHERE brand = 'Heco' AND product_name LIKE '%Wood and Drywall Screw%' AND properties LIKE '%screw type: wood screw%' AND properties LIKE '%diameter: 3 mm%';"
      },
      "bind": "product_sql"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_policy"
    }
  ],
  "rowsets": [
    {
      "from_": "product_sql",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "record_path"
      ],
      "into": "record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$record_path",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "notfound"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "Product found: {record_path}",
      "outcome": "OUTCOME_OK",
      "refs": []
    },
    "notfound": {
      "message": "Product not found.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    }
  },
  "custom_extract": []
}