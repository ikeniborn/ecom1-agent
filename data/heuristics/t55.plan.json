{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "_facts.identity"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "deny"
      }
    ],
    "default_label": "proceed"
  },
  "ops": [],
  "answer": {
    "deny": {
      "message": "Access denied: guests cannot view payment transactions.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "proceed": {
      "message": "Most recent payment: {record.payment_id}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$record.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}