{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path FROM product_variants pv JOIN product_variant_properties pvp1 ON pv.product_sku = pvp1.product_sku AND pvp1.property_key = 'anchor_type' AND pvp1.property_value_text = 'frame fixing' JOIN product_variant_properties pvp2 ON pv.product_sku = pvp2.product_sku AND pvp2.property_key = 'diameter_mm' AND pvp2.property_value_text = '6' JOIN product_variant_properties pvp3 ON pv.product_sku = pvp3.product_sku AND pvp3.property_key = 'length_mm' AND pvp3.property_value_text = '30' WHERE pv.brand = 'Wurth' AND pv.series = 'Wurth Universal WU XLL-87U' AND pv.model = 'Anchor and Wall Plug';"
      },
      "bind": "product_data"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT s.record_path AS store_record_path, COALESCE(si.available_today_quantity, 0) AS available_today_quantity FROM stores s LEFT JOIN store_inventory si ON s.store_id = si.store_id AND si.product_sku = :sku WHERE s.city = 'Graz' ORDER BY s.store_id;"
      },
      "bind": "inventory_data"
    }
  ],
  "rowsets": [
    {
      "from_": "product_data",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "inventory_data",
      "format": "auto_delim",
      "into": "inventory_rows",
      "columns": [
        {
          "into": "store_record_path",
          "candidates": [
            "store_record_path"
          ]
        },
        {
          "into": "available_today_quantity",
          "candidates": [
            "available_today_quantity"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$product_rows"
      ],
      "into": "product_count"
    },
    {
      "prim": "column",
      "args": [
        "$product_rows",
        "product_sku"
      ],
      "into": "sku_list"
    },
    {
      "prim": "first",
      "args": [
        "$sku_list"
      ],
      "into": "product_sku"
    },
    {
      "prim": "column",
      "args": [
        "$product_rows",
        "product_record_path"
      ],
      "into": "prp_list"
    },
    {
      "prim": "first",
      "args": [
        "$prp_list"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "sum_col",
      "args": [
        "$inventory_rows",
        "available_today_quantity"
      ],
      "into": "total_qty"
    },
    {
      "prim": "column",
      "args": [
        "$inventory_rows",
        "store_record_path"
      ],
      "into": "store_record_paths"
    },
    {
      "prim": "count",
      "args": [
        "$inventory_rows"
      ],
      "into": "num_store_citations"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$product_count",
          "rhs": 0,
          "args": []
        },
        "label": "unsupported"
      }
    ],
    "default_label": "found"
  },
  "ops": [],
  "answer": {
    "unsupported": {
      "message": "Product not found or no stores in Graz.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "found": {
      "message": "Total available today quantity: {total_qty}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$store_record_paths"
        }
      ]
    }
  },
  "custom_extract": []
}