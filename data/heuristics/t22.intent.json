{
  "objective": "Check out the caller's shopping basket, completing the purchase.",
  "desired_outcome": "OUTCOME_NONE_CLARIFICATION",
  "params": {
    "basket_id": "extract from instruction, or null if not provided"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_DENIED_SECURITY",
    "OUTCOME_NONE_CLARIFICATION"
  ],
  "constraints": [],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$basket_id",
        "rhs": null,
        "args": []
      },
      {
        "op": "eq",
        "lhs": "$payment_status",
        "rhs": "completed",
        "args": []
      }
    ],
    "OUTCOME_DENIED_SECURITY": [],
    "OUTCOME_NONE_CLARIFICATION": []
  },
  "answer_shape": {
    "msg_skeleton": "Checkout {outcome}: {message}"
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ],
    "OUTCOME_DENIED_SECURITY": [
      {
        "kind": "policy_doc",
        "path": "/docs/security.md",
        "source": null
      },
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ],
    "OUTCOME_NONE_CLARIFICATION": []
  }
}