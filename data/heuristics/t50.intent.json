{
  "objective": "Checkout the newest open basket for the caller's account, if the caller is a customer and the basket is ready today; otherwise, indicate the operation is unsupported.",
  "desired_outcome": "OUTCOME_NONE_UNSUPPORTED",
  "params": {
    "customer_id": "$_facts.identity.customer_id",
    "basket": "newest open basket for that customer_id from shopping_baskets where basket_status = 'open' order by basket_created_at desc limit 1"
  },
  "outcome_space": [
    "OUTCOME_OK",
    "OUTCOME_NONE_UNSUPPORTED"
  ],
  "constraints": [],
  "success_criteria": {
    "OUTCOME_OK": [
      {
        "op": "nonempty",
        "lhs": "$answer.basket_id",
        "rhs": null,
        "args": []
      }
    ],
    "OUTCOME_NONE_UNSUPPORTED": [
      {
        "op": "eq",
        "lhs": "$_facts.identity.kind",
        "rhs": "guest",
        "args": []
      }
    ]
  },
  "answer_shape": {
    "msg_skeleton": "Checkout result: {message}"
  },
  "required_refs": {
    "OUTCOME_OK": [
      {
        "kind": "record_path",
        "path": null,
        "source": "$basket.record_path"
      }
    ],
    "OUTCOME_NONE_UNSUPPORTED": [
      {
        "kind": "policy_doc",
        "path": "/docs/checkout.md",
        "source": null
      }
    ]
  }
}