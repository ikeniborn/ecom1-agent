{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/current-updates/catalogue-counting-2025-10-08-cleaning-liquids-vienna.md"
      },
      "bind": "policy_doc_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [],
        "stdin": "PRAGMA table_info(stores)"
      },
      "bind": "stores_schema_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "args": [],
        "stdin": "SELECT COUNT(DISTINCT pv.product_sku) AS sku_count FROM product_variants pv JOIN store_inventory si ON pv.product_sku = si.product_sku JOIN stores st ON si.store_id = st.store_id WHERE pv.product_kind_id = (SELECT product_kind_id FROM product_kinds WHERE LOWER(TRIM(product_kind_name)) = 'cleaning liquid') AND LOWER(TRIM(st.city)) = 'vienna' AND st.is_open = 1 AND si.available_today_quantity > 0"
      },
      "bind": "count_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "count_raw",
      "format": "auto_delim",
      "into": "count_rows",
      "columns": [
        {
          "into": "sku_count",
          "candidates": [
            "sku_count"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$count_rows"
      ],
      "into": "count_row"
    },
    {
      "prim": "get",
      "args": [
        "$count_row",
        "sku_count"
      ],
      "into": "count_str"
    },
    {
      "prim": "to_number",
      "args": [
        "$count_str"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "<COUNT:{count}>",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}