{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(*) AS count FROM product_variants WHERE product_kind_id = (SELECT product_kind_id FROM product_kinds WHERE product_kind_name = 'Wiper Blade')"
      },
      "bind": "raw_output"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_output",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "count",
          "candidates": [
            "count"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$rows"
      ],
      "into": "result"
    },
    {
      "prim": "to_number",
      "args": [
        "$result.count"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ge",
          "lhs": "$count",
          "rhs": 0,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{count}",
      "outcome": "OUTCOME_OK",
      "refs": []
    }
  },
  "custom_extract": []
}