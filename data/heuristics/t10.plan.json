{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(*) AS count FROM product_variants v JOIN product_kinds k ON v.product_kind_id = k.product_kind_id WHERE k.product_kind_name = 'Work Gloves';"
      },
      "bind": "raw_sql_output"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "policy_doc"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_output",
      "format": "auto_delim",
      "into": "result",
      "columns": [
        {
          "into": "count",
          "candidates": [
            "count"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$result",
        "count"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ge",
          "lhs": "$result.count",
          "rhs": 0,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "denied_security"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        }
      ]
    },
    "denied_security": {
      "message": "Access denied",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    }
  },
  "custom_extract": []
}