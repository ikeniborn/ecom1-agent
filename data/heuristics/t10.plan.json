{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/current-updates/catalogue-counting-2025-10-08-work-trousers-vienna.md"
      },
      "bind": "policy_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH kind AS (SELECT product_kind_id FROM product_kinds WHERE product_kind_name = 'Work Trousers'), store AS (SELECT store_id FROM stores WHERE store_name = 'Vienna PowerTool' AND is_open = 1), cnt AS (SELECT COUNT(DISTINCT pv.product_sku) AS cnt FROM product_variants pv JOIN store_inventory si ON pv.product_sku = si.product_sku WHERE pv.product_kind_id = (SELECT product_kind_id FROM kind) AND si.store_id = (SELECT store_id FROM store) AND si.available_today_quantity > 0) SELECT cnt FROM cnt;"
      },
      "bind": "sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_output",
      "format": "auto_delim",
      "into": "parsed_count",
      "columns": [
        {
          "into": "cnt",
          "candidates": [
            "cnt"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$parsed_count"
      ],
      "into": "row"
    },
    {
      "prim": "get",
      "args": [
        "$row",
        "cnt"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "1",
          "rhs": "1",
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "ok"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "/docs/current-updates/catalogue-counting-2025-10-08-work-trousers-vienna.md"
      ]
    }
  },
  "custom_extract": []
}