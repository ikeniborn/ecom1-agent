{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.product_name, pv.record_path FROM product_variants pv JOIN product_families pf ON pv.product_family_id = pf.product_family_id JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku WHERE pv.brand = :brand AND (pv.series = :line OR pf.product_family_name = :line) AND pvp.property_key = 'tool type' AND pvp.property_value_text = :tool_type;"
      },
      "bind": "raw_sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_output",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_name",
          "candidates": [
            "product_name"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$rows",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "The product {product_name} (SKU: {product_sku}) is in the catalogue.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$rows.0.record_path"
        }
      ]
    },
    "not_found": {
      "message": "No matching product found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}