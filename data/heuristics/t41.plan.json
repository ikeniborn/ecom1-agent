{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "policy_3ds"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "policy_checkout"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "policy_security"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT * FROM shopping_baskets WHERE basket_id = 'basket_220';"
      },
      "bind": "basket_sql_result"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT * FROM payment_transactions WHERE basket_id = 'basket_220';"
      },
      "bind": "payment_sql_result"
    }
  ],
  "rowsets": [
    {
      "from_": "basket_sql_result",
      "format": "auto_delim",
      "into": "basket_rows",
      "columns": [
        {
          "into": "basket_id",
          "candidates": [
            "basket_id",
            "BASKET_ID"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path",
            "RECORD_PATH"
          ]
        },
        {
          "into": "basket_status",
          "candidates": [
            "basket_status",
            "BASKET_STATUS"
          ]
        }
      ]
    },
    {
      "from_": "payment_sql_result",
      "format": "auto_delim",
      "into": "payment_rows",
      "columns": [
        {
          "into": "payment_id",
          "candidates": [
            "payment_id",
            "PAYMENT_ID"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path",
            "RECORD_PATH"
          ]
        },
        {
          "into": "payment_status",
          "candidates": [
            "payment_status",
            "PAYMENT_STATUS"
          ]
        },
        {
          "into": "three_ds_status",
          "candidates": [
            "three_ds_status",
            "THREE_DS_STATUS"
          ]
        },
        {
          "into": "three_ds_attempts",
          "candidates": [
            "three_ds_attempts",
            "THREE_DS_ATTEMPTS"
          ]
        },
        {
          "into": "three_ds_max_attempts",
          "candidates": [
            "three_ds_max_attempts",
            "THREE_DS_MAX_ATTEMPTS"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "to_number",
      "args": [
        "$payment_rows.0.three_ds_attempts"
      ],
      "into": "attempts_num"
    },
    {
      "prim": "to_number",
      "args": [
        "$payment_rows.0.three_ds_max_attempts"
      ],
      "into": "max_attempts_num"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$payment_rows.0.payment_status",
              "rhs": "completed",
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$payment_rows.0.three_ds_status",
              "rhs": "successful",
              "args": []
            }
          ]
        },
        "label": "ok_done"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "eq",
              "lhs": "$basket_rows.0.basket_status",
              "rhs": "checked_out",
              "args": []
            },
            {
              "op": "in_set",
              "lhs": "$payment_rows.0.three_ds_status",
              "rhs": [
                "requires_action",
                "3ds-status2"
              ],
              "args": []
            },
            {
              "op": "lt",
              "lhs": "$attempts_num",
              "rhs": "$max_attempts_num",
              "args": []
            }
          ]
        },
        "label": "recover"
      }
    ],
    "default_label": "denied"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "UPDATE payment_transactions SET payment_status = 'completed', three_ds_status = 'successful' WHERE payment_id = '$payment_rows.0.payment_id';"
      },
      "bind": null,
      "guard_label": "recover",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "denied": {
      "message": "Access denied. Guests cannot modify baskets or payments. Basket {basket_rows.0.basket_id} cannot be processed.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket_rows.0.record_path"
        }
      ]
    },
    "ok_done": {
      "message": "Basket {basket_rows.0.basket_id} is now ready for checkout. Payment verification completed.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_rows.0.record_path"
        }
      ]
    },
    "recover": {
      "message": "Basket {basket_rows.0.basket_id} is now ready for checkout. Payment verification completed.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_rows.0.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}