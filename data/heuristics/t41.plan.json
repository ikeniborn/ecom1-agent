{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "deny_security"
      }
    ],
    "default_label": "clarify"
  },
  "ops": [],
  "answer": {
    "deny_security": {
      "message": "Access denied: guests cannot resolve checkout issues for customer baskets.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "clarify": {
      "message": "Identity is not guest; need to verify basket ownership.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    }
  },
  "custom_extract": []
}