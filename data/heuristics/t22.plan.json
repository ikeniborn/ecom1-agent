{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "first",
      "args": [
        []
      ],
      "into": "basket_id"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$basket_id",
          "rhs": null,
          "args": []
        },
        "label": "clarification"
      }
    ],
    "default_label": "clarification"
  },
  "ops": [],
  "answer": {
    "clarification": {
      "message": "Please provide the basket ID to complete checkout.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": []
    }
  },
  "custom_extract": []
}