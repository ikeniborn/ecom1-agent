{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH base AS (\n  SELECT pv.product_sku, pv.record_path\n  FROM product_variants pv\n  WHERE pv.brand = 'Schneider Electric' AND pv.series = 'Heavy Duty Merten 214-ZHY' AND pv.product_name = 'Extension Cable'\n  AND EXISTS (\n    SELECT 1 FROM product_variant_properties pvp1\n    WHERE pvp1.product_sku = pv.product_sku AND pvp1.property_key = 'color_family' AND pvp1.property_value_text = 'White'\n  )\n  AND EXISTS (\n    SELECT 1 FROM product_variant_properties pvp2\n    WHERE pvp2.product_sku = pv.product_sku AND pvp2.property_key = 'length' AND pvp2.property_value_text = '5 m'\n  )\n)\nSELECT base.product_sku, base.record_path,\n  EXISTS (\n    SELECT 1 FROM product_variant_properties pvp3\n    WHERE pvp3.product_sku = base.product_sku AND pvp3.property_key = 'length' AND pvp3.property_value_text = '10 m'\n  ) AS extra_claim_found\nFROM base;"
      },
      "bind": "sql_result"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_result",
      "format": "auto_delim",
      "into": "parsed_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "extra_claim_found",
          "candidates": [
            "extra_claim_found"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$parsed_rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "product_sku"
      ],
      "into": "base_sku"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "record_path"
      ],
      "into": "base_product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "extra_claim_found"
      ],
      "into": "extra_claim_found"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$base_sku",
          "rhs": null,
          "args": []
        },
        "label": "not_found"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$extra_claim_found",
          "rhs": 1,
          "args": []
        },
        "label": "extra_exists"
      }
    ],
    "default_label": "success"
  },
  "ops": [],
  "answer": {
    "not_found": {
      "message": "<NO>",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "extra_exists": {
      "message": "<NO>",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "success": {
      "message": "<NO> SKU: {base_sku}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$base_product_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}