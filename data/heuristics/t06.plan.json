{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path, pvp.property_value_text AS cleaner_type_value FROM product_variants pv LEFT JOIN product_variant_properties pvp ON pv.product_sku = pvp.product_sku AND pvp.property_key='cleaner type' WHERE pv.brand='Mellerud' AND pv.series='Bio MEL 233-MOB' AND pv.model='Cleaning Liquid' LIMIT 1;"
      },
      "bind": "product_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "product_raw",
      "format": "auto_delim",
      "into": "product_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "cleaner_type_value",
          "candidates": [
            "cleaner_type_value"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$product_rows"
      ],
      "into": "product_row"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "product_sku"
      ],
      "into": "product_sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$product_row",
        "cleaner_type_value"
      ],
      "into": "cleaner_type_value"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "contains_any",
              "lhs": "$cleaner_type_value",
              "rhs": [
                "multi surface cleaner"
              ],
              "args": []
            },
            {
              "op": "contains_any",
              "lhs": "$cleaner_type_value",
              "rhs": [
                "floor cleaner"
              ],
              "args": []
            }
          ]
        },
        "label": "both_present"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "nonempty",
              "lhs": "$product_sku",
              "rhs": null,
              "args": []
            },
            {
              "op": "not",
              "lhs": null,
              "rhs": null,
              "args": [
                {
                  "op": "and",
                  "lhs": null,
                  "rhs": null,
                  "args": [
                    {
                      "op": "contains_any",
                      "lhs": "$cleaner_type_value",
                      "rhs": [
                        "multi surface cleaner"
                      ],
                      "args": []
                    },
                    {
                      "op": "contains_any",
                      "lhs": "$cleaner_type_value",
                      "rhs": [
                        "floor cleaner"
                      ],
                      "args": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        "label": "not_both"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "both_present": {
      "message": "Checked product {product_sku}: claim that it has both cleaner types is confirmed. Answer: YES",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        }
      ]
    },
    "not_both": {
      "message": "Checked product {product_sku}: claim that it has both cleaner types is absent. Answer: NO",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "not_found": {
      "message": "Product not found for Mellerud Bio MEL 233-MOB Cleaning Liquid.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}