{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path, (SELECT COUNT(*) FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND ((pvp.property_key = 'fastener_type' AND pvp.property_value_text IN ('bolt', 'threaded rod')) OR (pvp.property_key = 'diameter' AND pvp.property_value_text = '8 mm'))) AS property_count FROM product_variants pv WHERE pv.brand = 'Heco' AND pv.series = 'HECO 3DW-64B' AND pv.product_name LIKE '%Nut Bolt and Washer%';"
      },
      "bind": "product_rows"
    }
  ],
  "rowsets": [
    {
      "from_": "product_rows",
      "format": "auto_delim",
      "into": "product_rows_parsed",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "property_count",
          "candidates": [
            "property_count"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$product_rows_parsed"
      ],
      "into": "row_count"
    },
    {
      "prim": "column",
      "args": [
        "$product_rows_parsed",
        "property_count"
      ],
      "into": "property_counts"
    },
    {
      "prim": "first",
      "args": [
        "$property_counts"
      ],
      "into": "property_count"
    },
    {
      "prim": "column",
      "args": [
        "$product_rows_parsed",
        "product_sku"
      ],
      "into": "skus"
    },
    {
      "prim": "first",
      "args": [
        "$skus"
      ],
      "into": "sku"
    },
    {
      "prim": "column",
      "args": [
        "$product_rows_parsed",
        "record_path"
      ],
      "into": "record_paths"
    },
    {
      "prim": "first",
      "args": [
        "$record_paths"
      ],
      "into": "record_path"
    },
    {
      "prim": "first",
      "args": [
        "$product_rows_parsed"
      ],
      "into": "row"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$row_count",
          "rhs": 0,
          "args": []
        },
        "label": "no_product"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "gt",
              "lhs": "$row_count",
              "rhs": 0,
              "args": []
            },
            {
              "op": "eq",
              "lhs": "$property_count",
              "rhs": 3,
              "args": []
            }
          ]
        },
        "label": "found_with_props"
      },
      {
        "when": {
          "op": "and",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "gt",
              "lhs": "$row_count",
              "rhs": 0,
              "args": []
            },
            {
              "op": "lt",
              "lhs": "$property_count",
              "rhs": 3,
              "args": []
            }
          ]
        },
        "label": "found_without_props"
      }
    ],
    "default_label": "no_product"
  },
  "ops": [],
  "answer": {
    "no_product": {
      "message": "Product not found in catalogue.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "found_with_props": {
      "message": "YES (SKU: {sku})",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$row.record_path"
        }
      ]
    },
    "found_without_props": {
      "message": "NO (SKU: {sku})",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$row.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}