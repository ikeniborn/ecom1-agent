{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH fam AS (SELECT product_family_id FROM product_families WHERE brand = 'Heco' AND product_family_name LIKE '%TopFix GTU-YPJ%' AND product_family_name LIKE '%Wood and Drywall Screw%' LIMIT 1) SELECT v.record_path FROM product_variants v JOIN fam ON v.product_family_id = fam.product_family_id WHERE EXISTS (SELECT 1 FROM product_variant_properties p WHERE p.product_sku = v.product_sku AND p.property_key = 'diameter' AND p.property_value_text = '6 mm') LIMIT 1;"
      },
      "bind": "product_query"
    }
  ],
  "rowsets": [],
  "compute": [
    {
      "prim": "column",
      "args": [
        "$product_query.rows",
        "record_path"
      ],
      "into": "record_paths"
    },
    {
      "prim": "first",
      "args": [
        "$record_paths"
      ],
      "into": "product_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$record_paths",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "Product found: {product_record_path}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        }
      ]
    },
    "not_found": {
      "message": "No matching product found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}