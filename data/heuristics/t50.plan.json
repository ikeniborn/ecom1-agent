{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "checkout_policy"
    }
  ],
  "rowsets": [],
  "compute": [],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ne",
          "lhs": "$_facts.identity.kind",
          "rhs": "customer",
          "args": []
        },
        "label": "guest_clarify"
      }
    ],
    "default_label": "guest_clarify"
  },
  "ops": [],
  "answer": {
    "guest_clarify": {
      "message": "Unable to checkout: guest identity cannot have an account. Please log in as a customer.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        }
      ]
    }
  },
  "custom_extract": []
}