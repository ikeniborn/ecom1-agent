{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "policy_content"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": ".mode csv\nSELECT DISTINCT payment_status, three_ds_status FROM payment_transactions WHERE is_archived_basket_reference = 1;"
      },
      "bind": "marking_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": ".mode csv\nSELECT record_path, payment_id, payment_status, three_ds_status FROM payment_transactions WHERE is_archived_basket_reference = 1 AND payment_status = 'requires_3ds_action' AND three_ds_status = 'failed';"
      },
      "bind": "fraud_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "fraud_raw",
      "format": "auto_delim",
      "into": "fraud_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "payment_id",
          "candidates": [
            "payment_id"
          ]
        },
        {
          "into": "payment_status",
          "candidates": [
            "payment_status"
          ]
        },
        {
          "into": "three_ds_status",
          "candidates": [
            "three_ds_status"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$fraud_rows"
      ],
      "into": "fraud_count"
    },
    {
      "prim": "column",
      "args": [
        "$fraud_rows",
        "record_path"
      ],
      "into": "fraud_record_paths"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$fraud_record_paths",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "Found {fraud_count} fraudulent payment record(s): {fraud_record_paths}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "source": "$fraud_record_paths"
        }
      ]
    },
    "not_found": {
      "message": "No fraudulent payment records found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}