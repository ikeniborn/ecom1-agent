{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "policy_3ds"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "policy_security"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/checkout.md"
      },
      "bind": "policy_checkout"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT DISTINCT payment_status, three_ds_status FROM payment_transactions WHERE is_archived_basket_reference = 1;"
      },
      "bind": "archived_statuses_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM payment_transactions WHERE is_archived_basket_reference = 1 AND (payment_status = 'fraud' OR three_ds_status = 'failed');"
      },
      "bind": "fraud_records_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "archived_statuses_raw",
      "format": "auto_delim",
      "into": "archived_statuses",
      "columns": [
        {
          "into": "payment_status",
          "candidates": [
            "payment_status"
          ]
        },
        {
          "into": "three_ds_status",
          "candidates": [
            "three_ds_status"
          ]
        }
      ]
    },
    {
      "from_": "fraud_records_raw",
      "format": "auto_delim",
      "into": "record",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$record"
      ],
      "into": "count"
    },
    {
      "prim": "column",
      "args": [
        "$record",
        "record_path"
      ],
      "into": "record_path_list"
    },
    {
      "prim": "concat",
      "args": [
        "$record_path_list",
        ", "
      ],
      "into": "record_paths"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "ge",
          "lhs": "$count",
          "rhs": 1,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "none_unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "Identified {count} fraudulent archived payment records: {record_paths}",
      "outcome": "OUTCOME_OK",
      "refs": [
        "$policy_3ds",
        "$record"
      ]
    },
    "none_unsupported": {
      "message": "No fraudulent archived payment records found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}