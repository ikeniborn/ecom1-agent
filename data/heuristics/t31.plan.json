{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "policy_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/id"
      },
      "bind": "identity_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH payment AS (SELECT * FROM payment_transactions WHERE payment_id = 'pay_010'), basket AS (SELECT basket_status FROM shopping_baskets WHERE basket_id = 'basket_210') SELECT p.*, b.basket_status FROM payment p, basket b;"
      },
      "bind": "payment_basket_data"
    }
  ],
  "rowsets": [
    {
      "from_": "payment_basket_data",
      "format": "json",
      "into": "payment_basket_rows",
      "columns": []
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$payment_basket_rows"
      ],
      "into": "payment_row"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "payment_status"
      ],
      "into": "payment_status"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_status"
      ],
      "into": "three_ds_status"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_attempts"
      ],
      "into": "three_ds_attempts"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "three_ds_max_attempts"
      ],
      "into": "three_ds_max_attempts"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "basket_status"
      ],
      "into": "basket_status"
    },
    {
      "prim": "get",
      "args": [
        "$payment_row",
        "record_path"
      ],
      "into": "payment_record_path"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$payment_row",
          "rhs": null,
          "args": []
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$basket_status",
          "rhs": "checked_out",
          "args": []
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "ne",
          "lhs": "$payment_status",
          "rhs": "requires_3ds_action",
          "args": []
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "not",
          "lhs": null,
          "rhs": null,
          "args": [
            {
              "op": "in_set",
              "lhs": "$three_ds_status",
              "rhs": [
                "status2",
                "status3"
              ],
              "args": []
            }
          ]
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "ge",
          "lhs": "$three_ds_attempts",
          "rhs": "$three_ds_max_attempts",
          "args": []
        },
        "label": "unsupported"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$identity_raw",
          "rhs": "guest",
          "args": []
        },
        "label": "unsupported"
      }
    ],
    "default_label": "ok"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "UPDATE payment_transactions SET three_ds_status = 'status1', three_ds_attempts = 0, three_ds_failure_reason = NULL WHERE payment_id = 'pay_010';"
      },
      "bind": null,
      "guard_label": "ok",
      "outcome_from_exit": {
        "ok_outcome": "OUTCOME_OK",
        "keyword_buckets": [],
        "default_outcome": "OUTCOME_ERR_INTERNAL"
      }
    }
  ],
  "answer": {
    "ok": {
      "message": "Restarted 3DS authentication for payment {payment_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    },
    "unsupported": {
      "message": "Cannot restart 3DS authentication for payment {payment_id}.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}