{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH payment AS (SELECT 'pay_027' AS payment_id) SELECT p.payment_id, rr.return_id FROM payment p LEFT JOIN return_requests rr ON rr.payment_id = p.payment_id;"
      },
      "bind": "query_result_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "query_result_raw",
      "format": "auto_delim",
      "into": "query_result",
      "columns": [
        {
          "into": "payment_id",
          "candidates": [
            "payment_id"
          ]
        },
        {
          "into": "return_id",
          "candidates": [
            "return_id"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$query_result"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "payment_id"
      ],
      "into": "payment_id"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "return_id"
      ],
      "into": "return_id"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      },
      {
        "when": {
          "op": "isnull",
          "lhs": "$return_id",
          "rhs": null,
          "args": []
        },
        "label": "no_return"
      }
    ],
    "default_label": "denied_security"
  },
  "ops": [],
  "answer": {
    "denied_security": {
      "message": "Refund approval for payment {payment_id} denied: caller is a guest and lacks authorization.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        }
      ]
    },
    "no_return": {
      "message": "No return request found for payment {payment_id}.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}