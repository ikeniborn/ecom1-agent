{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_policy_text"
    },
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/payments/3ds.md"
      },
      "bind": "threeds_policy_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path, payment_id, basket_id FROM payment_transactions WHERE payment_id = 'pay_052';"
      },
      "bind": "payment_query_result"
    }
  ],
  "rowsets": [
    {
      "from_": "payment_query_result",
      "format": "auto_delim",
      "into": "payment_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "payment_id",
          "candidates": [
            "payment_id"
          ]
        },
        {
          "into": "basket_id",
          "candidates": [
            "basket_id"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$payment_rows"
      ],
      "into": "payment_record"
    },
    {
      "prim": "get",
      "args": [
        "$payment_record",
        "record_path"
      ],
      "into": "payment_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$payment_record",
        "payment_id"
      ],
      "into": "payment_id"
    },
    {
      "prim": "get",
      "args": [
        "$payment_record",
        "basket_id"
      ],
      "into": "basket_id"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "eq",
          "lhs": "$_facts.identity.kind",
          "rhs": "guest",
          "args": []
        },
        "label": "denied_security"
      }
    ],
    "default_label": "ok"
  },
  "ops": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "UPDATE payment_transactions SET three_ds_status = 'requires_3ds_action', three_ds_attempts = 0 WHERE payment_id = 'pay_052';"
      },
      "bind": null,
      "guard_label": "ok",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "denied_security": {
      "message": "3DS recovery denied: only customers may initiate 3DS recovery.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/security.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    },
    "ok": {
      "message": "3DS recovery flow restarted for payment {payment_id} on basket {basket_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/payments/3ds.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$payment_record_path"
        }
      ]
    }
  },
  "custom_extract": []
}