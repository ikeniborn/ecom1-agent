{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH cleaner_key AS (\n  SELECT property_key FROM product_variant_properties\n  WHERE property_key LIKE '%cleaner%' AND property_value_text = 'interior cleaner'\n  LIMIT 1\n)\nSELECT * FROM (\n  SELECT pv.product_sku, pv.record_path, pv.brand, pf.product_family_name, pv.product_name,\n         (SELECT property_value_text FROM product_variant_properties pvp2\n          WHERE pvp2.product_sku = pv.product_sku AND pvp2.property_key = (SELECT property_key FROM cleaner_key)\n          LIMIT 1) AS cleaner_type\n  FROM product_variants pv\n  JOIN product_families pf ON pv.product_family_id = pf.product_family_id\n  WHERE pv.brand = 'Mellerud' AND pf.product_family_name = 'Mellerud Eco MEL 1AA-TXA Cleaning Liquid'\n) sub\nWHERE cleaner_type = 'interior cleaner';"
      },
      "bind": "raw_sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "raw_sql_output",
      "format": "auto_delim",
      "into": "catalogue_rows",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "brand",
          "candidates": [
            "brand"
          ]
        },
        {
          "into": "product_family_name",
          "candidates": [
            "product_family_name"
          ]
        },
        {
          "into": "product_name",
          "candidates": [
            "product_name"
          ]
        },
        {
          "into": "cleaner_type",
          "candidates": [
            "cleaner_type"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "count",
      "args": [
        "$catalogue_rows"
      ],
      "into": "match_count"
    },
    {
      "prim": "first",
      "args": [
        "$catalogue_rows"
      ],
      "into": "record"
    },
    {
      "prim": "get",
      "args": [
        "$record",
        "product_name"
      ],
      "into": "product_name"
    },
    {
      "prim": "get",
      "args": [
        "$record",
        "product_sku"
      ],
      "into": "product_sku"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$record.record_path",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "The product is in the catalogue: {product_name} (SKU: {product_sku}).",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$record.record_path"
        }
      ]
    },
    "not_found": {
      "message": "The product is not in the catalogue.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}