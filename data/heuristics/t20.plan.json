{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT pv.product_sku, pv.record_path FROM product_variants pv WHERE pv.brand = 'Record Power' AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'machine_type' AND pvp.property_value_text = 'compressor') AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'voltage' AND pvp.property_value_text = '230 V') AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'power' AND pvp.property_value_text = '3000 W') LIMIT 1;"
      },
      "bind": "product_info_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM stores WHERE city = 'Vienna';"
      },
      "bind": "vienna_stores_raw"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COALESCE(SUM(available_today_quantity), 0) as total FROM store_inventory WHERE product_sku = (SELECT pv.product_sku FROM product_variants pv WHERE pv.brand = 'Record Power' AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'machine_type' AND pvp.property_value_text = 'compressor') AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'voltage' AND pvp.property_value_text = '230 V') AND EXISTS (SELECT 1 FROM product_variant_properties pvp WHERE pvp.product_sku = pv.product_sku AND pvp.property_key = 'power' AND pvp.property_value_text = '3000 W') LIMIT 1) AND store_id IN (SELECT store_id FROM stores WHERE city = 'Vienna');"
      },
      "bind": "inventory_sum_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "product_info_raw",
      "format": "auto_delim",
      "into": "product_info",
      "columns": [
        {
          "into": "product_sku",
          "candidates": [
            "product_sku"
          ]
        },
        {
          "into": "product_record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "vienna_stores_raw",
      "format": "auto_delim",
      "into": "vienna_stores",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    },
    {
      "from_": "inventory_sum_raw",
      "format": "auto_delim",
      "into": "inventory_sum",
      "columns": [
        {
          "into": "total",
          "candidates": [
            "total"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "get",
      "args": [
        "$product_info",
        "product_sku"
      ],
      "into": "sku"
    },
    {
      "prim": "get",
      "args": [
        "$product_info",
        "product_record_path"
      ],
      "into": "product_record_path"
    },
    {
      "prim": "get",
      "args": [
        "$inventory_sum",
        "total"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$product_info",
          "rhs": null,
          "args": []
        },
        "label": "found"
      }
    ],
    "default_label": "not_found"
  },
  "ops": [],
  "answer": {
    "found": {
      "message": "count: {count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.0.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.1.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.2.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.3.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.4.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.5.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.6.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.7.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.8.record_path"
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$vienna_stores.9.record_path"
        }
      ]
    },
    "not_found": {
      "message": "Product not found",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}