{
  "discovery": [
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT record_path FROM product_variants;"
      },
      "bind": "product_paths_raw"
    }
  ],
  "rowsets": [
    {
      "from_": "product_paths_raw",
      "format": "auto_delim",
      "into": "product_paths_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "column",
      "args": [
        "$product_paths_rows",
        "record_path"
      ],
      "into": "product_record_paths"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$store_id",
          "rhs": null,
          "args": []
        },
        "label": "has_store"
      }
    ],
    "default_label": "need_store"
  },
  "ops": [],
  "answer": {
    "need_store": {
      "message": "Please provide the store identifier to check availability.",
      "outcome": "OUTCOME_NONE_CLARIFICATION",
      "refs": [
        {
          "kind": "record_path",
          "path": null,
          "source": "$product_record_paths"
        }
      ]
    },
    "has_store": {
      "message": "Store ID provided but full matching not implemented.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}