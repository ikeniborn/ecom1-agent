{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/policy-updates/2024-07-17-catalogue-reporting-compressors-extractors-linz.md"
      },
      "bind": "policy_doc_content"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT COUNT(DISTINCT pv.product_sku) AS cnt FROM product_variants pv JOIN store_inventory si ON pv.product_sku = si.product_sku JOIN stores s ON si.store_id = s.store_id WHERE pv.product_kind_id = 'compressors_extractors' AND s.store_name = 'Linz PowerTool' AND s.is_open = 1 AND si.available_today_quantity > 0;"
      },
      "bind": "sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_output",
      "format": "auto_delim",
      "into": "rows",
      "columns": [
        {
          "into": "cnt",
          "candidates": [
            "cnt"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$rows"
      ],
      "into": "row"
    },
    {
      "prim": "get",
      "args": [
        "$row",
        "cnt"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$policy_doc_content",
          "rhs": null,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{count}",
      "outcome": "OUTCOME_OK",
      "refs": []
    },
    "unsupported": {
      "message": "The policy document is empty or could not be read.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}