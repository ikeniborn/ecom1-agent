{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/policy-updates/2024-07-17-catalogue-reporting-wall-paint-vienna.md"
      },
      "bind": "policy_content"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "WITH vienna_powertool_stores AS (SELECT store_id FROM stores WHERE is_open = 1 AND city = 'Vienna' AND store_name LIKE '%PowerTool%') SELECT COUNT(DISTINCT pv.product_sku) AS count FROM product_variants pv WHERE pv.product_kind_id = 'wall_paint' AND EXISTS (SELECT 1 FROM store_inventory si JOIN vienna_powertool_stores vps ON si.store_id = vps.store_id WHERE si.product_sku = pv.product_sku AND si.available_today_quantity > 0);"
      },
      "bind": "sql_result"
    }
  ],
  "rowsets": [
    {
      "from_": "sql_result",
      "format": "auto_delim",
      "into": "parsed_rows",
      "columns": [
        {
          "into": "count",
          "candidates": [
            "count"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$parsed_rows"
      ],
      "into": "first_row"
    },
    {
      "prim": "get",
      "args": [
        "$first_row",
        "count"
      ],
      "into": "count"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "nonempty",
          "lhs": "$policy_content",
          "rhs": null,
          "args": []
        },
        "label": "ok"
      }
    ],
    "default_label": "unsupported"
  },
  "ops": [],
  "answer": {
    "ok": {
      "message": "{count}",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/policy-updates/2024-07-17-catalogue-reporting-wall-paint-vienna.md",
          "source": null
        }
      ]
    },
    "unsupported": {
      "message": "Policy document not found or empty",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    }
  },
  "custom_extract": []
}