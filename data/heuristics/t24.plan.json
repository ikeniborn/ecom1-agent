{
  "discovery": [
    {
      "rpc": "Read",
      "args": {
        "path": "/docs/security.md"
      },
      "bind": "security_policy_text"
    },
    {
      "rpc": "Exec",
      "args": {
        "path": "/bin/sql",
        "stdin": "SELECT b.record_path, b.store_id, b.basket_status, b.discount_issuer_employee_id, s.is_open FROM shopping_baskets b JOIN stores s ON b.store_id = s.store_id WHERE b.basket_id = 'basket_001';"
      },
      "bind": "basket_sql_output"
    }
  ],
  "rowsets": [
    {
      "from_": "basket_sql_output",
      "format": "auto_delim",
      "into": "basket_sql_rows",
      "columns": [
        {
          "into": "record_path",
          "candidates": [
            "record_path"
          ]
        },
        {
          "into": "store_id",
          "candidates": [
            "store_id"
          ]
        },
        {
          "into": "basket_status",
          "candidates": [
            "basket_status"
          ]
        },
        {
          "into": "discount_issuer_employee_id",
          "candidates": [
            "discount_issuer_employee_id"
          ]
        },
        {
          "into": "is_open",
          "candidates": [
            "is_open"
          ]
        }
      ]
    }
  ],
  "compute": [
    {
      "prim": "first",
      "args": [
        "$basket_sql_rows"
      ],
      "into": "basket_sql_row"
    },
    {
      "prim": "get",
      "args": [
        "$basket_sql_row",
        "record_path"
      ],
      "into": "basket.record_path"
    },
    {
      "prim": "get",
      "args": [
        "$basket_sql_row",
        "store_id"
      ],
      "into": "store_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket_sql_row",
        "basket_status"
      ],
      "into": "basket_status"
    },
    {
      "prim": "get",
      "args": [
        "$basket_sql_row",
        "discount_issuer_employee_id"
      ],
      "into": "discount_issuer_employee_id"
    },
    {
      "prim": "get",
      "args": [
        "$basket_sql_row",
        "is_open"
      ],
      "into": "is_open"
    },
    {
      "prim": "first",
      "args": [
        "$basket_sql_rows"
      ],
      "into": "basket"
    }
  ],
  "decision": {
    "branches": [
      {
        "when": {
          "op": "isnull",
          "lhs": "$discount_issuer_employee_id",
          "rhs": null,
          "args": []
        },
        "label": "denied_no_override"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$basket_status",
          "rhs": "checked_out",
          "args": []
        },
        "label": "already_checked_out"
      },
      {
        "when": {
          "op": "eq",
          "lhs": "$is_open",
          "rhs": 0,
          "args": []
        },
        "label": "store_closed"
      },
      {
        "when": {
          "op": "isnull",
          "lhs": "$basket",
          "rhs": null,
          "args": []
        },
        "label": "basket_not_found"
      }
    ],
    "default_label": "ok"
  },
  "ops": [
    {
      "rpc": "Write",
      "args": {
        "path": "/proc/checkout/processed_basket_001",
        "content": "processed"
      },
      "bind": null,
      "guard_label": "ok",
      "outcome_from_exit": null
    }
  ],
  "answer": {
    "denied_no_override": {
      "message": "Checkout denied: no override for guest.",
      "outcome": "OUTCOME_DENIED_SECURITY",
      "refs": []
    },
    "already_checked_out": {
      "message": "Checkout not possible: basket already checked out.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "store_closed": {
      "message": "Checkout not possible: store is closed.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "basket_not_found": {
      "message": "Basket not found.",
      "outcome": "OUTCOME_NONE_UNSUPPORTED",
      "refs": []
    },
    "ok": {
      "message": "Checkout processed for basket {basket_id}.",
      "outcome": "OUTCOME_OK",
      "refs": [
        {
          "kind": "policy_doc",
          "path": "/docs/checkout.md",
          "source": null
        },
        {
          "kind": "record_path",
          "path": null,
          "source": "$basket.record_path"
        }
      ]
    }
  },
  "custom_extract": []
}