# ─── Общее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG → логировать RAW LLM-ответы
TZ=                                  # пусто = системный

# ─── Benchmark ──────────────────────────────────────────────────────────────
BENCHMARK_HOST=https://api.bitgn.com
BENCHMARK_ID=bitgn/pac1-dev
BITGN_RUN_NAME=pac1-dev-your-name
TASK_TIMEOUT_S=300
PARALLEL_TASKS=1
MAX_STEPS=5
# RUN_BENCHMARK=1                    # test-only: enable live-benchmark pytest markers (tests/)

# ─── Модель ─────────────────────────────────────────────────────────────────
MODEL=anthropic/claude-sonnet-4-6
MODEL_FALLBACK=                      # fallback after primary exhausts all tiers

# ─── Phase Models ────────────────────────────────────────────────────────────
MODEL_DESIGN=                        # DESIGN phase model (defaults to MODEL)
MODEL_LEARN=                         # LEARN phase model (defaults to MODEL)
MODEL_CODEGEN=                       # CODEGEN phase model (defaults to MODEL)
MODEL_TEST=                          # TEST-GEN phase model (defaults to MODEL)

# ─── HTTP timeouts ───────────────────────────────────────────────────────────
LLM_HTTP_READ_TIMEOUT_S=180          # HTTP read timeout for LLM calls
LLM_HTTP_CONNECT_TIMEOUT_S=10        # HTTP connect timeout for LLM calls

# ─── Phase Max Tokens ────────────────────────────────────────────────────────
MAX_TOKENS_DESIGN=8192               # DESIGN phase response limit
MAX_TOKENS_INTENT=4096               # INTENT phase response limit (agent/reason.py)
MAX_TOKENS_PLAN=8192                 # PLAN phase response limit (agent/reason.py)
FIDELITY_TIMEOUT_S=30                # subprocess timeout for fidelity gate
COMPACTION_THRESHOLD=15              # entry count that triggers learn_ctx compaction
COMPACTION_KEEP_RECENT=5             # recent entries kept verbatim after compaction
MAX_TOKENS_LEARN=8192
MAX_TOKENS_CODEGEN=8192              # CODEGEN phase response limit
MAX_TOKENS_TEST=2048                 # TEST-GEN phase response limit
TRAIN_MAX_CYCLES=5
DESIGN_MAX_ATTEMPTS=3                # DESIGN retry attempts on parse failure

# ─── Pipeline / Pre-phase ────────────────────────────────────────────────────
INTERPRETER_ENABLED=0                # 1 → Plan-IR deterministic interpreter instead of free-form CODEGEN
INTERPRETER_MAX_STEPS=6              # interpreter cycle ceiling (MAX_STEPS no longer drives it)
PREPHASE_PATH_LITERALS=3             # cap on path literals from the instruction (learned deep-read paths are additional)
PREPHASE_LISTING_BYTES=4096          # byte budget for pre-phase directory-listing facts; overflow → "… +N skipped"
PREPHASE_SAMPLE_ROWS=3               # LIMIT per sampled table (Tier-2)
PREPHASE_SAMPLE_ROW_CHARS=400        # per-row byte cap (Tier-2 safety rail)

# ─── Intent-driven test gate (TDD) ───────────────────────────────────────────
TDD_ENABLED=0                        # 1 → generate intent-tests + gate the answer before submit
TDD_MOCK_ENABLED=0                   # 1 → in-loop MockVMSpy fail-fast pre-check (best-effort)
TDD_FORCE_SUBMIT_AFTER=3             # consecutive test fails → submit best answer (avoid CLARIFICATION regress)

# ─── Ollama ─────────────────────────────────────────────────────────────────
# Модели формата name:tag (без слэша) → Ollama. Примеры: qwen3.5:cloud.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=           # ключ для OpenAI-совместимого прокси (пусто = "ollama"); значение — только в .secrets
# OLLAMA_MODEL=           # override the Ollama model name sent to the endpoint (defaults to MODEL)

# ─── Claude Code tier (опционально) ─────────────────────────────────────────
# Активируется префиксом claude-code/* в MODEL.
# CC_ENABLED=1
# ICLAUDE_CMD=iclaude
# CC_MAX_RETRIES=2
# CC_RETRY_DELAY_S=4                  # delay between iclaude retries
# CC_STRIP_PROJECT_ENV=1             # 1 → spawn iclaude with a clean env (drop project vars)
# CC_DEBUG_EMPTY=1                   # 1 → dump diagnostics on empty iclaude responses
# --- global fallbacks when a model's cc_options omits a key ---
# CC_DEFAULT_MODEL=                  # --model alias (haiku|sonnet|opus)
# CC_DEFAULT_EFFORT=                 # low|medium|high|xhigh|max
# CC_DEFAULT_TIMEOUT_S=180           # cc subprocess timeout
# CC_DEFAULT_FALLBACK_MODEL=         # --fallback-model alias
# CC_DEFAULT_EXCLUDE_DYNAMIC=        # 1 → --exclude-dynamic-system-prompt-sections

# ─── Knowledge oracle ─────────────────────────────────────────────────────────
ORACLE_ENABLED=1                     # 0 disables retrieval; pipeline behaves as before
EMBED_MODEL=nomic-embed-text         # embedding model id (key into models.json)
# EMBED_BASE_URL=                    # defaults to OLLAMA_BASE_URL
ORACLE_TOPN=10                       # stage-1 cosine candidate count
ORACLE_K=4                           # final atoms injected into CODEGEN
ORACLE_FLOOR=0.5                      # min cosine to inject an atom; below-floor candidates discarded
# MODEL_RANK=                        # stage-2 re-rank model; defaults to MODEL
ORACLE_RANK_ENABLED=1                # 0 = cosine top-k, skip LLM re-rank
ORACLE_DISTILL=0                     # 1 = auto-distill candidate atoms after LEARN
