# ─── Общее ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG → логировать RAW LLM-ответы
TZ=                                  # пусто = системный

# ─── Benchmark ──────────────────────────────────────────────────────────────
BENCHMARK_HOST=https://api.bitgn.com
BENCHMARK_ID=bitgn/pac1-dev
BITGN_RUN_NAME=pac1-dev-your-name
BITGN_API_KEY=                       # API-ключ для авторизации на harness
TASK_TIMEOUT_S=300
PARALLEL_TASKS=1
MAX_STEPS=5

# ─── Модель ─────────────────────────────────────────────────────────────────
MODEL=anthropic/claude-sonnet-4-6
MODEL_FALLBACK=                      # fallback after primary exhausts all tiers

# ─── Phase Models ────────────────────────────────────────────────────────────
MODEL_DESIGN=                        # DESIGN phase model (defaults to MODEL)
MODEL_LEARN=                         # LEARN phase model (defaults to MODEL)
MODEL_CODEGEN=                       # CODEGEN phase model (defaults to MODEL)

# ─── HTTP timeouts ───────────────────────────────────────────────────────────
LLM_HTTP_READ_TIMEOUT_S=180          # HTTP read timeout for LLM calls
LLM_HTTP_CONNECT_TIMEOUT_S=10        # HTTP connect timeout for LLM calls

# ─── Phase Max Tokens ────────────────────────────────────────────────────────
MAX_TOKENS_DESIGN=8192               # DESIGN phase response limit
FIDELITY_TIMEOUT_S=30                # subprocess timeout for fidelity gate
COMPACTION_THRESHOLD=15              # entry count that triggers learn_ctx compaction
COMPACTION_KEEP_RECENT=5            # recent entries kept verbatim after compaction
MAX_TOKENS_LEARN=8192
MAX_TOKENS_CODEGEN=8192              # CODEGEN phase response limit
TRAIN_MAX_CYCLES=5

# ─── Ollama ─────────────────────────────────────────────────────────────────
# Модели формата name:tag (без слэша) → Ollama. Примеры: qwen3.5:cloud.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=           # ключ для OpenAI-совместимого прокси (пусто = "ollama"); значение — только в .secrets

# ─── Claude Code tier (опционально) ─────────────────────────────────────────
# Активируется префиксом claude-code/* в MODEL.
# CC_ENABLED=1
# ICLAUDE_CMD=iclaude
# CC_MAX_RETRIES=2
