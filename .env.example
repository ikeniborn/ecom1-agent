# ─── Общее ──────────────────────────────────────────────────────────────────
# All agent-owned vars are namespaced ECOM_* so they never collide with shell- or
# harness-exported generics (e.g. a system OLLAMA_BASE_URL / MODEL). Everything —
# config AND credentials — lives in a single .env (gitignored via **/.env); there
# is no separate .secrets file. TZ stays unprefixed (system timezone for log
# timestamps). All model ids use the ECOM_MODEL_<PHASE> convention.
ECOM_LOG_LEVEL=INFO                       # DEBUG → логировать RAW LLM-ответы
TZ=                                  # пусто = системный

# ─── Benchmark ──────────────────────────────────────────────────────────────
ECOM_BENCHMARK_HOST=https://api.bitgn.com
ECOM_BENCHMARK_ID=bitgn/pac1-dev
ECOM_BITGN_RUN_NAME=pac1-dev-your-name
ECOM_PARALLEL_TASKS=1
# RUN_BENCHMARK=1                    # test-only marker gate (tests/); not read by the agent

# ─── Models ──────────────────────────────────────────────────────────────────
# Resolution per phase: ECOM_MODEL_<PHASE> → tier env → ECOM_MODEL. ECOM_MODEL_REASON
# is the catch-all for every phase not explicitly fast-tier (incl. unlisted phases).
ECOM_MODEL=anthropic/claude-sonnet-4-6     # primary LLM (anthropic/… | openrouter/… | ollama name:tag | claude-code/…)
ECOM_MODEL_FALLBACK=anthropic/claude-sonnet-4-6  # cross-provider safety net: used after the primary model exhausts all tiers (incl. empty/None CC-tier response)
ECOM_MODEL_REASON=                         # reason tier (INTENT/PLAN/iLEARN/distill); defaults to ECOM_MODEL
ECOM_MODEL_FAST=                           # fast tier (DOC_SELECT/rerank/INVESTIGATE); defaults to ECOM_MODEL
ECOM_MODEL_LEARN=                          # per-phase override for LEARN (defaults to ECOM_MODEL_REASON → ECOM_MODEL)
# ECOM_MODEL_INVESTIGATE=                  # per-phase override for the read-only INVESTIGATE router/digest (defaults to its fast tier)
# ECOM_MODEL_RANK=                         # stage-2 oracle re-rank model; defaults to ECOM_MODEL
ECOM_MODEL_EMBED=nomic-embed-text          # embedding model id (key into models.json); endpoint = ECOM_OLLAMA_BASE_URL

# ─── HTTP timeouts ───────────────────────────────────────────────────────────
ECOM_LLM_HTTP_READ_TIMEOUT_S=120          # HTTP read timeout for LLM calls (120*3=360s fits inside the 600s task cap)
ECOM_LLM_HTTP_CONNECT_TIMEOUT_S=10        # HTTP connect timeout for LLM calls
ECOM_LLM_MAX_RETRIES=2                   # per-call retry budget (default 2; worst-case 120*(2+1)=360s < 600s task cap)

# ─── Phase Max Tokens ────────────────────────────────────────────────────────
ECOM_MAX_TOKENS_INTENT=4096               # INTENT phase response limit (agent/reason.py)
ECOM_MAX_TOKENS_PLAN=8192                 # PLAN phase response limit (agent/reason.py)
ECOM_MAX_TOKENS_LEARN=8192                # LEARN / iLEARN phase response limit
ECOM_LEARN_MAX_ACTIVE=3                   # cap on active content-rules per task (iLEARN re-bloat guard); oldest UNPINNED deactivated, pinned:true exempt
ECOM_TRAIN_MAX_CYCLES=5
ECOM_DESIGN_MAX_ATTEMPTS=3                # INTENT retry attempts on transient parse/empty failure

# ─── Pipeline / Pre-phase ────────────────────────────────────────────────────
ECOM_INTERPRETER_MAX_STEPS=6              # Plan-IR interpreter cycle ceiling
ECOM_EMPTY_PLAN_MAX=2                     # consecutive empty-PLAN responses tolerated before terminal CLARIFICATION (skips iLEARN on empty)
ECOM_PREPHASE_PATH_LITERALS=3             # cap on path literals from the instruction (learned deep-read paths are additional)
ECOM_PREPHASE_LISTING_BYTES=4096          # byte budget for pre-phase directory-listing facts; overflow → "… +N skipped"
ECOM_PREPHASE_SAMPLE_ROWS=3               # LIMIT per sampled table (Tier-2)
ECOM_PREPHASE_SAMPLE_ROW_CHARS=400        # per-row byte cap (Tier-2 safety rail)

# ─── INVESTIGATE phase (read-only ReAct → brief) ─────────────────────────────
ECOM_INVESTIGATE_ENABLED=1                # 1 → slim seed + step-wise investigator builds the PLAN brief; 0 → eager gather + legacy oracle dump (exact baseline)
ECOM_INVESTIGATE_MAX_STEPS=6             # investigator ReAct step budget
ECOM_INVESTIGATE_ORACLE_K=2              # oracle atoms retrieved per investigator step (scoped to the step goal)

# ─── Ollama / OpenAI-compatible endpoint ─────────────────────────────────────
# Модели формата name:tag (без слэша) → Ollama. Примеры: qwen3.5:cloud.
ECOM_OLLAMA_BASE_URL=http://localhost:11434/v1   # or http://localhost:4000/v1 for a local litellm proxy
# ECOM_OLLAMA_MODEL=           # override the Ollama model name sent to the endpoint (defaults to ECOM_MODEL)

# ─── Claude Code tier (опционально) ─────────────────────────────────────────
# Активируется префиксом claude-code/* в ECOM_MODEL.
# CC caveat for the INVESTIGATE phase (measured on t38, claude-code/sonnet):
#   - INVESTIGATE router/digest steps are CHEAP regardless of tier (~20 s each,
#     think=off, 1024 tok) — pinning the fast tier to haiku barely changes latency.
#   - The dominant CC cost is the reason-tier PLAN call (~10-12 min each on sonnet).
#     INVESTIGATE can push a hard task into MORE PLAN cycles (t38: 1 cycle/DENIED OFF
#     → 2-4 cycles/CLARIFICATION ON), so total wall-clock can grow a lot on CC.
# Setting fast=haiku is a COST (not latency) optimisation — cheaper tokens for the
# short investigate steps while INTENT/PLAN keep the strong model:
# ECOM_MODEL_FAST=claude-code/haiku
# ECOM_CC_ENABLED=1
# ECOM_ICLAUDE_CMD=iclaude
ECOM_CC_MAX_RETRIES=1                  # lower retries for PLAN-heavy runs so a timing-out subprocess fails fast instead of ~3×180s
# ECOM_CC_RETRY_DELAY_S=4             # delay between iclaude retries
# ECOM_CC_STRIP_PROJECT_ENV=1        # 1 → spawn iclaude with a clean env (drop project vars)
# ECOM_CC_DEBUG_EMPTY=1              # 1 → dump diagnostics on empty iclaude responses
# --- global fallbacks when a model's cc_options omits a key ---
# ECOM_CC_DEFAULT_MODEL=             # --model alias (haiku|sonnet|opus)
# ECOM_CC_DEFAULT_EFFORT=            # low|medium|high|xhigh|max
ECOM_CC_DEFAULT_TIMEOUT_S=180          # cc subprocess timeout
# ECOM_CC_DEFAULT_FALLBACK_MODEL=    # --fallback-model alias
# ECOM_CC_DEFAULT_EXCLUDE_DYNAMIC=   # 1 → --exclude-dynamic-system-prompt-sections

# ─── Knowledge oracle ─────────────────────────────────────────────────────────
ECOM_ORACLE_ENABLED=1                     # 0 disables retrieval; pipeline behaves as before
ECOM_ORACLE_TOPN=10                       # stage-1 cosine candidate count
ECOM_ORACLE_K=4                           # final atoms injected into PLAN after re-rank
ECOM_ORACLE_FLOOR=0.5                      # min cosine to inject an atom; below-floor candidates discarded
ECOM_ORACLE_RANK_ENABLED=1                # 0 = cosine top-k, skip LLM re-rank
ECOM_ORACLE_DEDUP_COSINE=0.92             # cosine ≥ this ⇒ atoms are duplicates (oracle.prune + add_candidate dedup-on-insert); lower = more aggressive collapse

# ─── Credentials ──────────────────────────────────────────────────────────────
# Real secret values go in your own .env (gitignored). Only set the providers you
# use; leave the rest commented. The agent reads ECOM_*-prefixed keys ONLY, so a
# stray system ANTHROPIC_API_KEY / OPENAI_API_KEY can never leak in.
# ECOM_OLLAMA_API_KEY=        # key for an OpenAI-compatible Ollama/litellm proxy (empty → "ollama")
# ECOM_ANTHROPIC_API_KEY=     # Anthropic SDK (ECOM_MODEL=anthropic/...)
# ECOM_OPENROUTER_API_KEY=    # OpenRouter (ECOM_MODEL=openrouter/...)
# ECOM_BITGN_API_KEY=         # BitGN benchmark submission key
